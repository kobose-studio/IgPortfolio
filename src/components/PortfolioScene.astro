---
import portfolioData from '../portfolio_cache.json';
---

<div id="canvas-container" class="w-full h-screen relative bg-neutral-900 overflow-hidden cursor-grab active:cursor-grabbing">
  <div id="instructions" class="absolute top-6 left-6 z-10 text-xs font-mono tracking-widest text-neutral-400 pointer-events-none uppercase">
    [ IMLAND 3D Matrix — Infinite Virtual Scroll Active ]
  </div>
  <div id="scroll-indicator" class="absolute bottom-6 right-6 z-10 text-xs font-mono tracking-widest text-neutral-500 pointer-events-none uppercase">
    Scroll / Drag to Navigate
  </div>
</div>

<script>
  import * as THREE from 'three';
  import rawData from '../portfolio_cache.json';

  const container = document.getElementById('canvas-container');
  if (container) {
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.z = 10;

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    const vertexShader = `
      varying vec2 vUv;
      uniform float uTime;
      uniform vec2 uMouse;
      uniform float uVelocity;

      void main() {
        vUv = uv;
        vec3 pos = position;
        
        float dist = distance(uv, uMouse);
        pos.z += sin(dist * 8.0 - uTime * 2.0) * 0.08;
        pos.z += sin(pos.y * 1.5) * uVelocity * 0.25;

        gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
      }
    `;

    const fragmentShader = `
      varying vec2 vUv;
      uniform sampler2D uTexture;
      uniform float uTime;
      uniform float uVelocity;

      void main() {
        vec2 uv = vUv;
        
        float distortion = sin(uv.y * 15.0 + uTime * 2.5) * (0.006 + abs(uVelocity) * 0.02);
        uv.x += distortion;

        float shift = 0.003 + abs(uVelocity) * 0.01;
        float r = texture2D(uTexture, uv + vec2(shift, 0.0)).r;
        float g = texture2D(uTexture, uv).g;
        float b = texture2D(uTexture, uv - vec2(shift, 0.0)).b;

        gl_FragColor = vec4(r, g, b, 1.0);
      }
    `;

    const textureLoader = new THREE.TextureLoader();
    const mediaItems = rawData.data || [];
    const materials: THREE.ShaderMaterial[] = [];
    const meshes: THREE.Mesh[] = [];
    const basePositions: { x: number; y: number }[] = [];

    const geometry = new THREE.PlaneGeometry(2.2, 2.8, 32, 32);

    const COLS = 5;
    const ROWS = Math.ceil(mediaItems.length / COLS);
    const SPACING_X = 2.8;
    const SPACING_Y = 3.6;
    const TOTAL_HEIGHT = ROWS * SPACING_Y;

    mediaItems.forEach((item: any, index: number) => {
      const imageUrl = item.media_url || item.thumbnail_url;
      if (!imageUrl) return;

      const texture = textureLoader.load(imageUrl);
      
      const material = new THREE.ShaderMaterial({
        vertexShader,
        fragmentShader,
        uniforms: {
          uTexture: { value: texture },
          uTime: { value: 0 },
          uMouse: { value: new THREE.Vector2(0.5, 0.5) },
          uVelocity: { value: 0 }
        },
        side: THREE.DoubleSide
      });

      const mesh = new THREE.Mesh(geometry, material);

      const col = index % COLS;
      const row = Math.floor(index / COLS);
      
      const initialX = (col - (COLS - 1) / 2) * SPACING_X;
      const initialY = -(row - (ROWS - 1) / 2) * SPACING_Y;

      mesh.position.x = initialX;
      mesh.position.y = initialY;
      mesh.position.z = Math.sin(index) * 0.4;

      basePositions.push({ x: initialX, y: initialY });
      scene.add(mesh);
      meshes.push(mesh);
      materials.push(material);
    });

    let scrollY = 0;
    let targetScrollY = 0;
    let scrollVelocity = 0;

    let isDragging = false;
    let startY = 0;

    window.addEventListener('wheel', (e) => {
      targetScrollY += e.deltaY * 0.004;
    }, { passive: true });

    window.addEventListener('pointerdown', (e) => {
      isDragging = true;
      startY = e.clientY;
    });

    window.addEventListener('pointermove', (e) => {
      if (isDragging) {
        const deltaY = e.clientY - startY;
        targetScrollY -= deltaY * 0.008;
        startY = e.clientY;
      }
    });

    window.addEventListener('pointerup', () => { isDragging = false; });
    window.addEventListener('pointerleave', () => { isDragging = false; });

    const mouse = { x: 0, y: 0, targetX: 0, targetY: 0 };
    window.addEventListener('mousemove', (e) => {
      mouse.targetX = (e.clientX / window.innerWidth - 0.5) * 2;
      mouse.targetY = -(e.clientY / window.innerHeight - 0.5) * 2;
    });

    const clock = new THREE.Clock();

    function animate() {
      requestAnimationFrame(animate);
      const elapsedTime = clock.getElapsedTime();

      const prevScrollY = scrollY;
      scrollY += (targetScrollY - scrollY) * 0.07;
      scrollVelocity = scrollY - prevScrollY;

      mouse.x += (mouse.targetX - mouse.x) * 0.05;
      mouse.y += (mouse.targetY - mouse.y) * 0.05;

      scene.rotation.y = mouse.x * 0.15;
      scene.rotation.x = -mouse.y * 0.15 + scrollVelocity * 0.6;

      const halfHeight = TOTAL_HEIGHT / 2;

      meshes.forEach((mesh, idx) => {
        const basePos = basePositions[idx];
        let currentY = basePos.y + scrollY;

        currentY = ((currentY + halfHeight) % TOTAL_HEIGHT + TOTAL_HEIGHT) % TOTAL_HEIGHT - halfHeight;
        mesh.position.y = currentY;

        mesh.rotation.z = Math.sin(elapsedTime + idx) * 0.03;
      });

      materials.forEach((mat) => {
        mat.uniforms.uTime.value = elapsedTime;
        mat.uniforms.uVelocity.value = scrollVelocity;
        mat.uniforms.uMouse.value.set(
          (mouse.x + 1) * 0.5,
          (mouse.y + 1) * 0.5
        );
      });

      renderer.render(scene, camera);
    }
    animate();

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });
  }
</script>
