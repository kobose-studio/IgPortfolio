---
import portfolioData from '../portfolio_cache.json';
---

<div id="canvas-container" class="w-full h-screen relative bg-neutral-900 overflow-hidden">
  <div id="instructions" class="absolute top-6 left-6 z-10 text-xs font-mono tracking-widest text-neutral-400 pointer-events-none uppercase">
    [ IMLAND 3D Matrix — GLSL Liquid Refraction Active ]
  </div>
</div>

<script>
  import * as THREE from 'three';
  import rawData from '../portfolio_cache.json';

  const container = document.getElementById('canvas-container');
  if (container) {
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.z = 10;

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    container.appendChild(renderer.domElement);

    // 1. Shaders GLSL Custom
    const vertexShader = `
      varying vec2 vUv;
      uniform float uTime;
      uniform vec2 uMouse;

      void main() {
        vUv = uv;
        vec3 pos = position;
        
        // Micro-deformazione d'onda tridimensionale
        float dist = distance(uv, uMouse);
        pos.z += sin(dist * 8.0 - uTime * 2.0) * 0.08;

        gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
      }
    `;

    const fragmentShader = `
      varying vec2 vUv;
      uniform sampler2D uTexture;
      uniform float uTime;

      void main() {
        vec2 uv = vUv;
        
        // Onda di rifrazione liquida
        float distortion = sin(uv.y * 15.0 + uTime * 2.5) * 0.006;
        uv.x += distortion;

        // Aberrazione cromatica (split RGB)
        float r = texture2D(uTexture, uv + vec2(0.003, 0.0)).r;
        float g = texture2D(uTexture, uv).g;
        float b = texture2D(uTexture, uv - vec2(0.003, 0.0)).b;

        gl_FragColor = vec4(r, g, b, 1.0);
      }
    `;

    const textureLoader = new THREE.TextureLoader();
    const mediaItems = rawData.data || [];
    const materials: THREE.ShaderMaterial[] = [];
    const meshes: THREE.Mesh[] = [];
    // Geometria arricchita di vertici per supportare la deformazione d'onda
    const geometry = new THREE.PlaneGeometry(2.2, 2.8, 32, 32);

    mediaItems.forEach((item: any, index: number) => {
      const imageUrl = item.media_url || item.thumbnail_url;
      if (!imageUrl) return;

      const texture = textureLoader.load(imageUrl);
      
      const material = new THREE.ShaderMaterial({
        vertexShader,
        fragmentShader,
        uniforms: {
          uTexture: { value: texture },
          uTime: { value: 0 },
          uMouse: { value: new THREE.Vector2(0.5, 0.5) }
        },
        side: THREE.DoubleSide
      });

      const mesh = new THREE.Mesh(geometry, material);

      const col = index % 5;
      const row = Math.floor(index / 5);
      mesh.position.x = (col - 2) * 2.8;
      mesh.position.y = -(row - 2) * 3.4;
      mesh.position.z = Math.sin(index) * 0.4;

      scene.add(mesh);
      meshes.push(mesh);
      materials.push(material);
    });

    const mouse = { x: 0, y: 0, targetX: 0, targetY: 0 };
    window.addEventListener('mousemove', (e) => {
      mouse.targetX = (e.clientX / window.innerWidth - 0.5) * 2;
      mouse.targetY = -(e.clientY / window.innerHeight - 0.5) * 2;
    });

    const clock = new THREE.Clock();

    function animate() {
      requestAnimationFrame(animate);
      const elapsedTime = clock.getElapsedTime();

      mouse.x += (mouse.targetX - mouse.x) * 0.05;
      mouse.y += (mouse.targetY - mouse.y) * 0.05;

      scene.rotation.y = mouse.x * 0.2;
      scene.rotation.x = -mouse.y * 0.2;

      // Aggiornamento uniforms GLSL per frame
      materials.forEach((mat) => {
        mat.uniforms.uTime.value = elapsedTime;
        mat.uniforms.uMouse.value.set(
          (mouse.x + 1) * 0.5, 
          (mouse.y + 1) * 0.5
        );
      });

      meshes.forEach((mesh, idx) => {
        mesh.rotation.z = Math.sin(elapsedTime + idx) * 0.03;
      });

      renderer.render(scene, camera);
    }
    animate();

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });
  }
</script>
