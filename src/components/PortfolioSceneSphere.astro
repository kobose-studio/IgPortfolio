    #brand-modal > div *, #contacts-modal > div *, #manifesto-modal > div * { min-width:0!important; max-width:100%!important; box-sizing:border-box!important; }
    #brand-modal h1, #brand-modal h2, #manifesto-modal h1, #manifesto-modal h2, #contacts-modal h1, #contacts-modal h2 { font-size:clamp(1.05rem,4.6vw,1.55rem)!important; line-height:1.15!important; overflow-wrap:break-word!important; word-break:break-word!important; }
