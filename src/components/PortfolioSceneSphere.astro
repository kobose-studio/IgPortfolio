    }
    html body [data-imland-logo="1"] img, img[src*="logo-imland"] { width:152px!important; max-width:152px!important; height:auto!important; }
    #editorial-stage.is-active, #editorial-stage.is-active > div { max-height:154px!important; height:154px!important; overflow-y:auto!important; overflow-x:hidden!important; -webkit-overflow-scrolling:touch!important; padding:10px 14px!important; scrollbar-width:thin!important; scrollbar-color:#C89E5A rgba(0,0,0,.06)!important; box-sizing:border-box!important; }
    #editorial-stage.is-active::-webkit-scrollbar, #editorial-stage.is-active > div::-webkit-scrollbar { width:4px!important; }
    #editorial-stage.is-active::-webkit-scrollbar-thumb, #editorial-stage.is-active > div::-webkit-scrollbar-thumb { background:#C89E5A!important; border-radius:999px!important; }
