---
import portfolioData from '../portfolio_cache.json';
import brandProducts from '../brand_products.json';
---

<div id="canvas-container">
  
  <!-- 🎵 TRACCIA AUDIO COLONNA SONORA IMLAND (.M4A OFFICIAL) -->
  <audio id="bg-soundtrack" src="/brand/soundtrack.m4a" loop preload="auto"></audio>

  <div class="bg-grain-overlay"></div>
  <div class="top-vapour-mask"></div>

  <!-- BRAND HEADER GLOBALE -->
  <div id="global-brand-logo">
    <img src="/brand/logo-imland.png" alt="IMLAND MONTEROSA" />
  </div>

  <!-- ⚜️ MAIN HUD NAVIGATION BAR CON AUDIO TOGGLE -->
  <nav id="hud-main-menu" class="font-mono-tech">
    <button class="hud-menu-btn" data-target="drawer-manifesto">[ MANIFESTO ]</button>
    <span class="hud-sep">//</span>
    <button class="hud-menu-btn" data-target="drawer-gear">[ OUTDOOR GEAR ]</button>
    <span class="hud-sep">//</span>
    <button class="hud-menu-btn" data-target="drawer-contacts">[ CONTACTS ]</button>
    <span class="hud-sep">//</span>
    <button id="btn-audio-toggle" class="hud-menu-btn text-sepia">[ 🔊 SOUND: OFF ]</button>
  </nav>

  <!-- HUD Right -->
  <div id="hud-right-vertical" class="hud-element font-mono-tech">
    ARCHIVE 2026 <span class="hud-divider">//</span> 
    <span id="hud-stream-status" class="hud-badge hidden md:inline">[WIDESCREEN_ASPECT_LOCKED]</span>
  </div>
  
  <!-- HUD Hover Target -->
  <div id="fixed-hover-hud" class="font-syne">
    <span class="hud-label font-mono-tech">TARGET //</span>
    <span id="fixed-hover-title">ESPLORA L'ARCHIVIO</span>
  </div>

  <!-- HUD Bottom Left -->
  <div id="hud-bottom-left" class="hud-element font-mono-tech">
    <span id="hud-loading-counter" class="hud-sepia">SYNCHRONIZING ARCHIVE...</span>
    <span class="hud-divider hidden md:inline">//</span>
    <span class="hud-sepia hidden md:inline">[▲/▼] SIZE  [◄/►] SPEED</span>
    <span class="hud-divider hidden md:inline">//</span>
    <span>MOVE MOUSE TO STEER</span>
  </div>

  <!-- ==================== DRAWER 1: MANIFESTO ==================== -->
  <div id="drawer-manifesto" class="editorial-drawer">
    <div class="drawer-content-box">
      <div class="drawer-header font-mono-tech">
        <span>IMLAND MONTEROSA // PHILOSOPHY</span>
        <button class="btn-close-drawer">[ CLOSE / ESC ]</button>
      </div>
      
      <div class="drawer-body">
        <span class="editorial-tag font-mono-tech">EST. ALAGNA MONTE ROSA // 45° 51' N, 7° 56' E</span>
        <h2 class="editorial-heading font-syne">IMLAND, DOVE L'UNICA RISPOSTA È NATURA.</h2>
        
        <p class="editorial-prose font-sans">
          IMLAND MONTEROSA nasce sotto l'ombra imponente della parete est del Monte Rosa. Non creiamo capi per il consumo di massa, né per la moda da passerella cittadina. 
        </p>
        <p class="editorial-prose font-sans">
          Progettiamo <strong>outfit outdoor ad alte prestazioni</strong> per chi vive la montagna con rispetto, silenzio e radici profonde. In un mondo saturo di rumore digitale, Alagna e le sue valli selvagge rimangono la nostra unica bussola esistenziale.
        </p>

        <div class="manifesto-quote-box font-mono-tech">
          "NON CERCHIAMO LA MONTAGNA PER EVADERE DALLA REALTÀ, MA PER RITROVARLA."
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== DRAWER 2: OUTDOOR GEAR ==================== -->
  <div id="drawer-gear" class="editorial-drawer">
    <div class="drawer-content-box gear-wide-box">
      <div class="drawer-header font-mono-tech">
        <span>IMLAND OUTDOOR OUTFIT // BRAND COLLECTION</span>
        <button class="btn-close-drawer">[ CLOSE / ESC ]</button>
      </div>
      
      <div class="drawer-body">
        <span class="editorial-tag font-mono-tech">ATELIER ALAGNA // OFFICIAL APPAREL</span>
        <h2 class="editorial-heading font-syne">EQUIPAGGIAMENTO MINERALE</h2>
        
        <div class="products-grid">
          {brandProducts.map((prod) => (
            <div class="product-card">
              <div class="product-img-container">
                <img src={prod.image} alt={prod.title} class="product-img" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';" />
                <div class="product-placeholder-box font-mono-tech">
                  <span class="ph-icon">📷</span>
                  <span class="ph-label">[ {prod.category} ]</span>
                  <span class="ph-coords">45° 51' N // ALAGNA</span>
                </div>
              </div>

              <div class="product-info-wrap">
                <div class="product-badge font-mono-tech">{prod.tag}</div>
                <div class="product-meta-type font-mono-tech">{prod.category}</div>
                <h3 class="product-title font-syne">{prod.title}</h3>
                <div class="product-subtitle font-mono-tech">{prod.subtitle}</div>
                <p class="product-desc font-sans">{prod.description}</p>
                
                <div class="product-footer">
                  <span class="product-price font-mono-tech">{prod.price}</span>
                  <button class="btn-product-action font-mono-tech">{prod.status}</button>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- ==================== DRAWER 3: CONTACTS & SOCIAL ==================== -->
  <div id="drawer-contacts" class="editorial-drawer">
    <div class="drawer-content-box">
      <div class="drawer-header font-mono-tech">
        <span>IMLAND MONTEROSA // DIRECT CONTACTS</span>
        <button class="btn-close-drawer">[ CLOSE / ESC ]</button>
      </div>
      
      <div class="drawer-body">
        <span class="editorial-tag font-mono-tech">COMMUNICATION CHANNEL</span>
        <h2 class="editorial-heading font-syne">CONNETTITI CON L'ARCHIVIO</h2>
        
        <div class="contact-links-list font-mono-tech">
          <a href="mailto:imlandmoterosa@gmail.com" class="contact-card-link">
            <span class="link-label">EMAIL DIRECT //</span>
            <span class="link-value">IMLANDMOTEROSA@GMAIL.COM ↗</span>
          </a>

          <a href="https://instagram.com" target="_blank" rel="noopener noreferrer" class="contact-card-link">
            <span class="link-label">INSTAGRAM ARCHIVE //</span>
            <span class="link-value">@IMLANDMONTEROSA ↗</span>
          </a>

          <a href="https://www.facebook.com/imlandmonterosa" target="_blank" rel="noopener noreferrer" class="contact-card-link">
            <span class="link-label">FACEBOOK PAGE //</span>
            <span class="link-value">FACEBOOK.COM/IMLANDMONTEROSA ↗</span>
          </a>

          <div class="location-card">
            <span class="link-label">HEADQUARTERS //</span>
            <span class="link-value">VIA DEI WALSER, 23, 13021 ALAGNA VALSESIA VC, ITALIA</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Stage Modale Editoriale -->
  <div id="editorial-stage">
    <div id="editorial-card">
       <div class="card-meta-bar">
         <div class="status-box">
           <span class="status-dot"></span>
           <span id="modal-date" class="font-mono-tech">DATE // 00.00.0000</span>
         </div>
         <span id="modal-type" class="badge-type font-mono-tech">IMAGE</span>
       </div>

       <div class="work-nav-bar">
         <button id="btn-prev-work" class="btn-nav font-mono-tech">[ ◄ FLY PREV ]</button>
         <span id="work-counter" class="work-counter-text font-mono-tech">001 / 000</span>
         <button id="btn-next-work" class="btn-nav font-mono-tech">[ FLY NEXT ► ]</button>
       </div>

       <h1 id="modal-title" class="font-syne">TITOLO_ITALIANO / ENGLISH_TITLE</h1>

       <p id="modal-caption" class="font-sans">
         Caricamento didascalia dall'archivio...
       </p>

       <div class="card-action-bar">
         <a id="modal-link" href="#" target="_blank" rel="noopener noreferrer" class="btn-primary font-mono-tech text-center">
           INSTAGRAM ↗
         </a>
         <button id="btn-close" class="btn-secondary font-mono-tech">
           [ RESUME VORTEX / ESC ]
         </button>
       </div>
    </div>
    <div id="video-stage"></div>
  </div>
</div>

<style>
  :global(body, html) { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background-color: #f2f2f0; color: #0d0d0d; font-family: 'Inter', sans-serif; -webkit-font-smoothing: antialiased; touch-action: none; }
  .bg-grain-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 1; opacity: 0.055; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E"); }
  .top-vapour-mask { position: absolute; top: 0; left: 0; width: 100vw; height: 180px; background: linear-gradient(to bottom, #f2f2f0 10%, transparent 100%); z-index: 50; pointer-events: none; }
  @media (min-width: 768px) { .top-vapour-mask { height: 260px; } }
  #canvas-container { width: 100vw; height: 100vh; position: relative; background-color: #f2f2f0; overflow: hidden; cursor: grab; }
  #canvas-container:active { cursor: grabbing; }

  .font-syne { font-family: 'Syne', sans-serif; font-weight: 800; }
  .font-mono-tech { font-family: 'Space Mono', monospace; }
  .font-sans { font-family: 'Inter', sans-serif; }

  #hud-main-menu {
    position: fixed; top: 20px; left: 50%; transform: translateX(-50%); z-index: 250;
    display: flex; align-items: center; gap: 8px; background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid #0d0d0d; padding: 6px 16px; box-shadow: 0 10px 28px rgba(0,0,0,0.08);
  }
  @media (min-width: 768px) { #hud-main-menu { top: 28px; padding: 8px 24px; gap: 14px; } }
  .hud-menu-btn { background: transparent; border: none; color: #0d0d0d; font-size: 9px; font-weight: 700; letter-spacing: 0.12em; cursor: pointer; transition: all 0.25s ease; padding: 4px 6px; }
  @media (min-width: 768px) { .hud-menu-btn { font-size: 10px; letter-spacing: 0.15em; } }
  .hud-menu-btn:hover { color: #C09E5A; }
  .hud-menu-btn.text-sepia { color: #C09E5A; }
  .hud-sep { color: #8c8c8c; font-size: 10px; }

  #global-brand-logo { position: absolute; top: 10px; left: 50%; transform: translateX(-50%); width: 356px; height: 160px; z-index: 105; pointer-events: none; mix-blend-mode: multiply; transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  #global-brand-logo img { width: 100%; height: 100%; object-fit: contain; object-position: center top; filter: drop-shadow(0 4px 12px rgba(0,0,0,0.05)); transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1); }
  #global-brand-logo.is-focused img { transform: scale(0.9); }
  @media (min-width: 768px) { #global-brand-logo { top: 15px; left: 36px; transform: none; width: 618px; height: 260px; } #global-brand-logo img { object-position: left top; } #global-brand-logo.is-focused { left: 36px; top: 15px; } #global-brand-logo.is-focused img { transform: scale(1); } }

  .hud-element { position: absolute; z-index: 10; font-size: 10px; letter-spacing: 0.15em; color: #1a1a1a; text-transform: uppercase; pointer-events: none; transition: opacity 0.4s ease; }
  @media (min-width: 768px) { .hud-element { font-size: 11px; letter-spacing: 0.22em; } }
  #hud-bottom-left { bottom: 20px; left: 20px; color: #8c8c8c; display: flex; align-items: center; flex-wrap: wrap; gap: 4px; }
  @media (min-width: 768px) { #hud-bottom-left { bottom: 36px; left: 36px; gap: 6px; } }
  #hud-right-vertical { top: 50%; right: 0px; transform-origin: center; transform: translate(35%, -50%) rotate(90deg); white-space: nowrap; text-align: center; display: flex; align-items: center; }
  @media (min-width: 768px) { #hud-right-vertical { right: 16px; transform: translate(25%, -50%) rotate(90deg); } }
  .hud-divider { color: #8c8c8c; margin: 0 4px; }
  .hud-badge { color: #C09E5A; margin-left: 8px; font-size: 10px; font-weight: bold; }
  .hud-sepia { color: #C09E5A; }

  #fixed-hover-hud {
    position: fixed; top: 70px; right: 20px; z-index: 110; pointer-events: none; opacity: 0;
    transform: translateY(-8px); background: rgba(13, 13, 13, 0.92); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
    border: 1px solid #C09E5A; color: #ffffff; padding: 8px 18px; font-size: 11px; letter-spacing: 0.10em; text-transform: uppercase;
    box-shadow: 0 12px 30px rgba(0,0,0,0.22); transition: opacity 0.3s cubic-bezier(0.16, 1, 0.3, 1), transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex; align-items: center; gap: 10px; max-width: 80vw;
  }
  @media (min-width: 768px) { #fixed-hover-hud { top: 32px; right: 36px; padding: 10px 22px; font-size: 12px; } }
  #fixed-hover-hud.is-active { opacity: 1; transform: translateY(0); }
  .hud-label { color: #C09E5A; font-size: 9px; letter-spacing: 0.18em; font-weight: 700; }
  #fixed-hover-title { color: #ffffff; font-weight: 800; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .editorial-drawer {
    position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 200; display: none; opacity: 0; pointer-events: none;
    background: rgba(242, 242, 240, 0.35); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1); overflow-y: auto; box-sizing: border-box; padding: 20px;
  }
  @media (min-width: 768px) { .editorial-drawer { padding: 60px 80px; } }
  .editorial-drawer.is-active { display: block; opacity: 1; pointer-events: auto; }

  .drawer-content-box { max-width: 720px; margin: 40px auto; background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border: 1px solid #0d0d0d; padding: 24px; box-shadow: 0 24px 60px rgba(0,0,0,0.12); }
  @media (min-width: 768px) { .drawer-content-box { padding: 40px; margin: 60px auto; } }
  .gear-wide-box { max-width: 1100px; }

  .drawer-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(13,13,13,0.15); padding-bottom: 12px; margin-bottom: 24px; font-size: 10px; color: #666; letter-spacing: 0.18em; }
  .btn-close-drawer { background: transparent; border: 1px solid #0d0d0d; color: #0d0d0d; font-size: 9px; font-weight: 700; cursor: pointer; padding: 6px 12px; letter-spacing: 0.15em; transition: all 0.2s ease; }
  .btn-close-drawer:hover { background: #C09E5A; border-color: #C09E5A; color: #fff; }

  .editorial-tag { font-size: 10px; color: #C09E5A; letter-spacing: 0.2em; font-weight: 700; display: block; margin-bottom: 8px; }
  .editorial-heading { font-size: 24px; color: #0d0d0d; letter-spacing: -0.02em; text-transform: uppercase; margin: 0 0 20px 0; line-height: 1.2; }
  @media (min-width: 768px) { .editorial-heading { font-size: 32px; } }

  .editorial-prose { font-size: 13px; color: #333; line-height: 1.7; margin-bottom: 16px; }
  @media (min-width: 768px) { .editorial-prose { font-size: 14px; } }

  .manifesto-quote-box { border-left: 3px solid #C09E5A; background: rgba(192, 158, 90, 0.08); padding: 16px 20px; font-size: 11px; color: #0d0d0d; letter-spacing: 0.12em; margin-top: 28px; line-height: 1.6; }

  .products-grid { display: grid; grid-template-columns: 1fr; gap: 20px; margin-top: 24px; }
  @media (min-width: 768px) { .products-grid { grid-template-columns: repeat(3, 1fr); gap: 24px; } }

  .product-card { border: 1px solid rgba(13,13,13,0.12); background: rgba(250, 250, 250, 0.95); padding: 16px; display: flex; flex-direction: column; transition: transform 0.3s ease, border-color 0.3s ease; }
  .product-card:hover { transform: translateY(-4px); border-color: #C09E5A; }
  
  .product-img-container { width: 100%; height: 190px; background: #e8e8e5; border: 1px solid rgba(13,13,13,0.1); margin-bottom: 16px; overflow: hidden; position: relative; }
  .product-img { width: 100%; height: 100%; object-fit: cover; }
  .product-placeholder-box { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: linear-gradient(135deg, #f0f0ed 0%, #e2e2dd 100%); color: #777; gap: 6px; }
  .ph-icon { font-size: 18px; opacity: 0.6; }
  .ph-label { font-size: 9px; font-weight: 700; letter-spacing: 0.15em; color: #0d0d0d; }
  .ph-coords { font-size: 8px; color: #C09E5A; letter-spacing: 0.12em; }

  .product-info-wrap { display: flex; flex-direction: column; flex-grow: 1; }
  .product-badge { font-size: 8px; font-weight: bold; color: #C09E5A; letter-spacing: 0.15em; margin-bottom: 4px; }
  .product-meta-type { font-size: 9px; color: #8c8c8c; letter-spacing: 0.15em; text-transform: uppercase; }
  .product-title { font-size: 14px; color: #0d0d0d; text-transform: uppercase; margin: 6px 0 4px 0; line-height: 1.25; }
  .product-subtitle { font-size: 9px; color: #555; margin-bottom: 10px; }
  .product-desc { font-size: 11px; color: #444; line-height: 1.5; margin-bottom: 16px; flex-grow: 1; }
  .product-footer { display: flex; justify-content: space-between; align-items: center; border-top: 1px solid rgba(13,13,13,0.08); padding-top: 12px; }
  .product-price { font-size: 12px; font-weight: bold; color: #0d0d0d; }
  .btn-product-action { background: #0d0d0d; color: #fff; border: none; font-size: 8px; font-weight: 700; letter-spacing: 0.12em; padding: 6px 10px; cursor: pointer; transition: background 0.2s; }
  .btn-product-action:hover { background: #C09E5A; }

  .contact-links-list { display: flex; flex-direction: column; gap: 12px; margin-top: 24px; }
  .contact-card-link, .location-card { display: flex; justify-content: space-between; align-items: center; padding: 16px; border: 1px solid rgba(13,13,13,0.12); background: rgba(250, 250, 250, 0.90); text-decoration: none; color: #0d0d0d; font-size: 11px; transition: all 0.2s ease; }
  .contact-card-link:hover { border-color: #C09E5A; background: #ffffff; }
  .link-label { color: #8c8c8c; font-size: 9px; letter-spacing: 0.15em; }
  .link-value { font-weight: 700; letter-spacing: 0.10em; color: #0d0d0d; }

  #editorial-stage { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: 100; display: none; opacity: 0; pointer-events: none; transition: opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1); }
  #editorial-stage.is-active { display: block; opacity: 1; pointer-events: auto; }
  #editorial-card { position: absolute; bottom: 12px; right: 12px; left: 12px; background: rgba(255, 255, 255, 0.94); backdrop-filter: blur(24px); -webkit-backdrop-filter: blur(24px); border: 1px solid #0d0d0d; padding: 14px 16px; box-shadow: 0 16px 36px rgba(0, 0, 0, 0.14); transform: translateY(20px); transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1); box-sizing: border-box; z-index: 101; }
  @media (min-width: 768px) { #editorial-card { bottom: 36px; right: 36px; left: auto; padding: 24px 28px; max-width: 420px; width: calc(100vw - 72px); } }
  #editorial-stage.is-active #editorial-card { transform: translateY(0); }
  .card-meta-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; border-bottom: 1px solid rgba(13, 13, 13, 0.1); padding-bottom: 6px; }
  @media (min-width: 768px) { .card-meta-bar { margin-bottom: 12px; padding-bottom: 10px; } }
  .status-box { display: flex; align-items: center; gap: 6px; font-size: 9px; color: #666666; letter-spacing: 0.15em; }
  @media (min-width: 768px) { .status-box { font-size: 10px; gap: 8px; letter-spacing: 0.2em; } }
  .status-dot { width: 6px; height: 6px; border-radius: 50%; background-color: #C09E5A; box-shadow: 0 0 8px #C09E5A; }
  .badge-type { font-size: 8px; font-weight: 700; letter-spacing: 0.15em; background: #0d0d0d; color: #ffffff; padding: 2px 6px; text-transform: uppercase; }
  @media (min-width: 768px) { .badge-type { font-size: 9px; padding: 3px 8px; letter-spacing: 0.2em; } }
  
  .work-nav-bar { display: flex; justify-content: space-between; align-items: center; gap: 8px; padding: 6px 0; margin: 6px 0 10px 0; border-top: 1px solid rgba(13, 13, 13, 0.1); border-bottom: 1px solid rgba(13, 13, 13, 0.1); box-sizing: border-box; width: 100%; }
  .btn-nav { background: transparent; border: 1px solid #0d0d0d; color: #0d0d0d; font-size: 8px; font-weight: 700; cursor: pointer; letter-spacing: 0.10em; padding: 4px 8px; white-space: nowrap; flex-shrink: 0; transition: all 0.2s ease; text-transform: uppercase; }
  @media (min-width: 768px) { .btn-nav { font-size: 9px; padding: 5px 10px; } }
  .btn-nav:hover { background: #C09E5A; border-color: #C09E5A; color: #ffffff; }
  .work-counter-text { font-size: 9px; color: #0d0d0d; letter-spacing: 0.15em; font-weight: 700; white-space: nowrap; text-align: center; }
  @media (min-width: 768px) { .work-counter-text { font-size: 10px; } }

  #modal-title { font-size: 15px; letter-spacing: -0.02em; color: #0d0d0d; text-transform: uppercase; margin: 6px 0; line-height: 1.25; }
  @media (min-width: 768px) { #modal-title { font-size: 18px; margin: 8px 0; } }
  #modal-caption { font-size: 11px; color: #404040; line-height: 1.45; max-height: 54px; overflow-y: auto; margin: 8px 0; padding-left: 8px; border-left: 2px solid #0d0d0d; }
  @media (min-width: 768px) { #modal-caption { font-size: 12px; max-height: 110px; line-height: 1.6; margin: 12px 0; padding-left: 12px; } }
  .card-action-bar { display: flex; align-items: center; justify-content: space-between; margin-top: 10px; padding-top: 8px; border-top: 1px solid rgba(13, 13, 13, 0.08); }
  @media (min-width: 768px) { .card-action-bar { margin-top: 16px; padding-top: 12px; } }
  .btn-primary { background: #0d0d0d; color: #ffffff; padding: 8px 14px; font-size: 9px; font-weight: 700; letter-spacing: 0.12em; text-decoration: none; text-transform: uppercase; transition: all 0.25s ease; border: 1px solid #0d0d0d; }
  @media (min-width: 768px) { .btn-primary { padding: 10px 18px; font-size: 10px; letter-spacing: 0.15em; } }
  .btn-primary:hover { background: #C09E5A; color: #ffffff; border-color: #C09E5A; }
  .btn-secondary { background: transparent; border: none; color: #737373; font-size: 9px; letter-spacing: 0.12em; cursor: pointer; text-transform: uppercase; transition: color 0.2s ease; padding: 6px 0; }
  @media (min-width: 768px) { .btn-secondary { font-size: 10px; letter-spacing: 0.15em; padding: 8px 0; } }
  .btn-secondary:hover { color: #0d0d0d; }

  #video-stage { position: absolute; top: 0; left: 0; width: 100vw; height: 100vh; pointer-events: none; z-index: 90; display: flex; justify-content: center; align-items: center; }
</style>

<script>
  import * as THREE from 'three';
  import rawData from '../portfolio_cache.json';

  // 🎵 WEB AUDIO API
  let audioCtx: AudioContext | null = null;
  let analyser: AnalyserNode | null = null;
  let audioDataArray: Uint8Array | null = null;
  let isAudioPlaying = false;

  const bgAudio = document.getElementById('bg-soundtrack') as HTMLAudioElement;
  const btnAudioToggle = document.getElementById('btn-audio-toggle');

  function initAudioContext() {
    if (audioCtx) return;
    try {
      audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      if (bgAudio) {
        const source = audioCtx.createMediaElementSource(bgAudio);
        analyser = audioCtx.createAnalyser();
        analyser.fftSize = 64;
        source.connect(analyser);
        analyser.connect(audioCtx.destination);
        audioDataArray = new Uint8Array(analyser.frequencyBinCount);
      }
    } catch (e) {
      console.warn("Audio Context init fallback:", e);
    }
  }

  function toggleAudio() {
    initAudioContext();
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume();
    }

    if (bgAudio) {
      if (isAudioPlaying) {
        bgAudio.pause();
        isAudioPlaying = false;
        if (btnAudioToggle) btnAudioToggle.innerText = '[ 🔊 SOUND: OFF ]';
      } else {
        bgAudio.play().then(() => {
          isAudioPlaying = true;
          if (btnAudioToggle) btnAudioToggle.innerText = '[ 🔊 SOUND: ON ]';
        }).catch(err => console.log("Audio gesture required:", err));
      }
    }
  }

  btnAudioToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleAudio();
  });

  // ⚜️ LOGICA DRAWERS MENU
  let activeDrawer: HTMLElement | null = null;

  function closeAllDrawers() {
    document.querySelectorAll('.editorial-drawer').forEach(el => el.classList.remove('is-active'));
    activeDrawer = null;
  }

  document.querySelectorAll('.hud-menu-btn').forEach(btn => {
    if (btn.id === 'btn-audio-toggle') return;
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const targetId = (btn as HTMLElement).dataset.target;
      if (!targetId) return;
      const targetDrawer = document.getElementById(targetId);
      
      if (targetDrawer === activeDrawer) {
        closeAllDrawers();
      } else {
        closeAllDrawers();
        if (targetDrawer) {
          targetDrawer.classList.add('is-active');
          activeDrawer = targetDrawer;
        }
      }
    });
  });

  document.querySelectorAll('.btn-close-drawer').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      closeAllDrawers();
    });
  });

  function parseBilingualTitle(caption: string) {
    if (!caption) return "OPERA D'ARCHIVIO";
    let cleanText = caption.replace(/#\w+/g, '').replace(/@\w+/g, '').trim();
    let rawLines = cleanText.split(/[\r\n]+/).map(l => l.trim()).filter(l => l.length > 0);
    let contentLines = rawLines.filter(line => !/IMLAND/i.test(line));
    if (contentLines.length === 0) return "MATERIA ISOLATA";
    let targetLine = contentLines[0];

    if (targetLine.includes('/')) {
      let parts = targetLine.split('/').map(p => p.trim().replace(/^['"•\s]+|['"•\s]+$/g, '')).filter(p => p.length > 0);
      parts = parts.filter(p => !/IMLAND/i.test(p));
      if (parts.length >= 2) return `${parts[0].toUpperCase()} / ${parts[1].toUpperCase()}`;
      else if (parts.length === 1) return parts[0].toUpperCase();
    }
    if (contentLines.length >= 2) {
      let itTitle = targetLine.toUpperCase();
      let enTitle = contentLines[1].toUpperCase();
      if (enTitle.length > 2 && !enTitle.startsWith('HTTP') && !/IMLAND/i.test(enTitle)) {
        if ((itTitle.length + enTitle.length) < 60) return `${itTitle} / ${enTitle}`;
      }
    }
    return targetLine.substring(0, 48).toUpperCase();
  }

  function createBadgeTexture(type: string) {
    const canvas = document.createElement('canvas'); canvas.width = 128; canvas.height = 128; const ctx = canvas.getContext('2d');
    if (!ctx) return new THREE.CanvasTexture(canvas);
    ctx.clearRect(0, 0, 128, 128); ctx.fillStyle = '#C09E5A'; ctx.strokeStyle = '#C09E5A';
    if (type === 'VIDEO') { ctx.beginPath(); ctx.moveTo(42, 32); ctx.lineTo(92, 64); ctx.lineTo(42, 96); ctx.closePath(); ctx.fill(); } 
    else if (type === 'CAROUSEL_ALBUM') { ctx.lineWidth = 10; ctx.lineJoin = 'round'; ctx.strokeRect(28, 48, 48, 48); ctx.fillRect(48, 24, 48, 48); ctx.strokeStyle = '#0d0d0d'; ctx.lineWidth = 2; ctx.strokeRect(48, 24, 48, 48); }
    const texture = new THREE.CanvasTexture(canvas); texture.premultiplyAlpha = true; texture.needsUpdate = true; return texture;
  }

  const container = document.getElementById('canvas-container');
  if (container) {
    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0xf2f2f0, 0.020);

    const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.set(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setClearColor(0xf2f2f0, 1); 
    container.appendChild(renderer.domElement);

    const worldGroup = new THREE.Group();
    scene.add(worldGroup);

    // ❄️ NEVE TRICROMA 3D AUDIO-REATTIVA
    const particleCount = 240;
    const particleTriangleGeo = new THREE.CircleGeometry(0.06, 3);
    const particleMaterial = new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.45, depthTest: true, depthWrite: false, side: THREE.DoubleSide });
    const pixelSnowSystem = new THREE.InstancedMesh(particleTriangleGeo, particleMaterial, particleCount);
    pixelSnowSystem.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
    
    const snowPalette = [ new THREE.Color('#282828'), new THREE.Color('#C09E5A'), new THREE.Color('#2C5260') ];
    const dummyMatrix = new THREE.Object3D();
    
    let snowScaleFactor = window.innerWidth < 640 ? 0.7 : 1.0;
    let snowSpeedFactor = 0.55;

    // 🌐 ESPANSIONE X/Y WIDESCREEN PER COPRIREI MARGINI LATERALI DEL MONITOR (X: -24 -> +24)
    const particleData: any[] = [];
    for (let p = 0; p < particleCount; p++) {
      pixelSnowSystem.setColorAt(p, snowPalette[Math.floor(Math.random() * snowPalette.length)]);
      particleData.push({
        x: (Math.random() - 0.5) * 48, y: (Math.random() - 0.5) * 32, z: (Math.random() - 0.5) * 35 - 10,
        vy: 0.003 + Math.random() * 0.006, rx: Math.random() * Math.PI * 2, ry: Math.random() * Math.PI * 2, rz: Math.random() * Math.PI * 2,
        vrx: (Math.random() - 0.5) * 0.035, vry: (Math.random() - 0.5) * 0.045, vrz: (Math.random() - 0.5) * 0.025
      });
    }
    if (pixelSnowSystem.instanceColor) pixelSnowSystem.instanceColor.needsUpdate = true;
    scene.add(pixelSnowSystem);

    const laserGeometry = new THREE.BufferGeometry();
    const laserPositions = new Float32Array(48);
    laserGeometry.setAttribute('position', new THREE.BufferAttribute(laserPositions, 3));
    const laserMaterial = new THREE.LineBasicMaterial({ color: 0xc09e5a, transparent: true, opacity: 0, linewidth: 2, depthTest: false });
    const laserMesh = new THREE.LineSegments(laserGeometry, laserMaterial);
    laserMesh.frustumCulled = false;
    scene.add(laserMesh);

    const vertexShader = `
      varying vec2 vUv;
      uniform float uTime;
      uniform vec2 uMouse;
      uniform float uVelocity;
      uniform float uFocus;

      void main() {
        vUv = uv;
        vec3 pos = position;

        float dist = distance(uv, uMouse);
        float wave = sin(dist * 7.0 - uTime * 2.5) * (0.03 + abs(uVelocity) * 0.12);
        float focusCurvature = (0.25 - (uv.x - 0.5)*(uv.x - 0.5) - (uv.y - 0.5)*(uv.y - 0.5)) * 0.35 * uFocus;

        pos.z += wave * (1.0 - uFocus);
        pos.z += focusCurvature;

        gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
      }
    `;

    const fragmentShader = `
      varying vec2 vUv;
      uniform sampler2D uTexture;
      uniform float uTime;
      uniform float uVelocity;
      uniform float uFocus;
      uniform float uOpacity;
      uniform float uTexAspect;
      uniform vec2 uMouse;

      void main() {
        vec2 uv = vUv;
        float planeAspect = 2.2 / 2.8; 
        vec2 st = uv - 0.5;
        if (uTexAspect > 0.0) {
          if (uTexAspect > planeAspect) st.x *= planeAspect / uTexAspect;
          else st.y *= uTexAspect / planeAspect;
        }
        uv = st + 0.5;

        float distFromCenter = length(vUv - vec2(0.5));
        float distortion = sin(uv.y * 12.0 + uTime * 3.0) * (0.003 + abs(uVelocity) * 0.015 + (uFocus * 0.001));
        uv.x += distortion;

        float chromaMask = smoothstep(0.10, 0.75, distFromCenter);
        vec2 redOffset  = (vec2(0.0025, 0.001) * (1.0 + uFocus * 0.5) * chromaMask) + vec2(uVelocity * 0.01, 0.0);
        vec2 blueOffset = (vec2(-0.0025, -0.001) * (1.0 + uFocus * 0.5) * chromaMask) - vec2(uVelocity * 0.01, 0.0);

        float r = texture2D(uTexture, uv + redOffset).r;
        float g = texture2D(uTexture, uv).g;
        float b = texture2D(uTexture, uv + blueOffset).b;
        vec3 color = vec3(r, g, b);

        if (uFocus > 0.01) {
          float vignette = smoothstep(0.75, 0.20, distFromCenter);
          vec3 warmGalleryLight = vec3(1.02, 0.99, 0.95);
          color = mix(color, color * warmGalleryLight * (0.88 + 0.12 * vignette), uFocus);
        }
        gl_FragColor = vec4(color, uOpacity);
      }
    `;

    const textureLoader = new THREE.TextureLoader();
    const mediaItems = rawData.data || []; 

    const materials: THREE.ShaderMaterial[] = [];
    const meshes: THREE.Mesh[] = [];
    const geometry = new THREE.PlaneGeometry(2.2, 2.8, 32, 32);
    const videoBadgeTexture = createBadgeTexture('VIDEO');
    const carouselBadgeTexture = createBadgeTexture('CAROUSEL_ALBUM');
    const badgeGeometry = new THREE.PlaneGeometry(0.22, 0.25);

    const SPACING_Z = 2.8;
    const TOTAL_DEPTH = mediaItems.length * SPACING_Z;
    const GOLDEN_ANGLE = 2.399963;
    let loadedCount = 0;

    mediaItems.forEach((item: any, index: number) => {
      let initialUrl = item.thumbnail_url || item.media_url;
      if (!initialUrl) return;

      const material = new THREE.ShaderMaterial({
        vertexShader, fragmentShader,
        uniforms: { 
          uTexture: { value: null },
          uTexAspect: { value: 1.0 }, 
          uFocus: { value: 0.0 }, 
          uOpacity: { value: 0.0 },
          uTime: { value: 0 },
          uVelocity: { value: 0 },
          uMouse: { value: new THREE.Vector2(0.5, 0.5) }
        },
        side: THREE.DoubleSide, transparent: true
      });

      const texture = textureLoader.load(initialUrl, (tex) => {
        if (tex.image) material.uniforms.uTexAspect.value = tex.image.width / tex.image.height;
        material.uniforms.uTexture.value = tex;
        mesh.userData.isLoaded = true;
        mesh.userData.coverTexture = tex;
        loadedCount++;
        
        const hudCounter = document.getElementById('hud-loading-counter');
        if (hudCounter && loadedCount < mediaItems.length) {
          hudCounter.innerText = `MATERIALIZING ARCHIVE // ${loadedCount} OF ${mediaItems.length} NODES`;
        } else if (hudCounter) {
          hudCounter.innerText = `STEER TUNNEL // SCROLL FOR PIXEL STORM`;
          const statusBadge = document.getElementById('hud-stream-status');
          if (statusBadge) statusBadge.innerText = `[STREAM_SYNCHRONIZED]`;
        }
      });

      const mesh = new THREE.Mesh(geometry, material);
      
      // 🪐 RAGGIO ADATTIVO DINAMICO PER APRIRE LA SPIRALE AI MARGINI WIDESCREEN
      const theta = index * GOLDEN_ANGLE;
      const radiusLayer = 6.2 + (index % 5) * 3.8 + (index * 0.025);
      
      const baseX = radiusLayer * Math.cos(theta);
      const baseY = radiusLayer * Math.sin(theta);
      const zBase = -index * SPACING_Z;

      const rotY = -Math.atan2(baseX, -zBase) * 0.4;
      const rotX = Math.atan2(baseY, -zBase) * 0.4;

      mesh.position.set(baseX, baseY, zBase);
      mesh.rotation.set(rotX, rotY, 0);

      let badgeMat: THREE.MeshBasicMaterial | null = null;
      if (item.media_type === 'VIDEO' || item.media_type === 'CAROUSEL_ALBUM') {
        const badgeTex = item.media_type === 'VIDEO' ? videoBadgeTexture : carouselBadgeTexture;
        badgeMat = new THREE.MeshBasicMaterial({ map: badgeTex, transparent: true, opacity: 0.0, depthTest: false, depthWrite: false });
        const badgeMesh = new THREE.Mesh(badgeGeometry, badgeMat);
        badgeMesh.frustumCulled = false; badgeMesh.renderOrder = 9999; 
        badgeMesh.position.set(2.2 / 2 - 0.22, -2.8 / 2 + 0.22, 0.15);
        mesh.add(badgeMesh);
      }

      mesh.userData = { 
        id: item.id, title: parseBilingualTitle(item.caption), media_type: item.media_type, media_url: item.media_url, 
        thumbnail_url: item.thumbnail_url, caption: item.caption, timestamp: item.timestamp ? new Date(item.timestamp).toLocaleDateString('it-IT') : 'ARCHIVIO', 
        permalink: item.permalink || '#', children: item.children ? item.children.data : null, 
        baseX: baseX, baseY: baseY, zBase: zBase, rotY: rotY, rotX: rotX,
        coverTexture: texture, badgeMat: badgeMat, isLoaded: false 
      };

      worldGroup.add(mesh); meshes.push(mesh); materials.push(material);
    });

    const raycaster = new THREE.Raycaster();
    const clickMouse = new THREE.Vector2();
    let activeMesh: THREE.Mesh | null = null;
    let activeMeshIndex = -1;

    let savedScrollZ: number | null = null;
    let scrollZ = 0, targetScrollZ = 0, prevScrollZ = 0, scrollVelocity = 0, isDragging = false, dragStartY = 0;
    const DRAG_MULTIPLIER = 0.08;
    const mouse = { x: 0, y: 0, targetX: 0, targetY: 0 };

    const editorialStage = document.getElementById('editorial-stage');
    const brandLogo = document.getElementById('global-brand-logo'); 
    const videoStage = document.getElementById('video-stage');
    
    const fixedHoverHud = document.getElementById('fixed-hover-hud');
    const fixedHoverTitle = document.getElementById('fixed-hover-title');

    function closeModal() {
      if (activeMesh) {
        activeMesh.renderOrder = 0;
        if (activeMesh.userData.coverTexture) activeMesh.material.uniforms.uTexture.value = activeMesh.userData.coverTexture;
      }
      activeMesh = null; activeMeshIndex = -1;
      
      if (savedScrollZ !== null) {
        targetScrollZ = savedScrollZ;
        savedScrollZ = null;
      }

      editorialStage?.classList.remove('is-active'); brandLogo?.classList.remove('is-focused'); 
      if (videoStage) videoStage.innerHTML = '';
    }

    function openModalForMesh(mesh: THREE.Mesh) {
      if (activeMesh && activeMesh.userData.coverTexture) {
        activeMesh.renderOrder = 0;
        activeMesh.material.uniforms.uTexture.value = activeMesh.userData.coverTexture;
      }
      
      if (!activeMesh) {
        savedScrollZ = targetScrollZ;
      }

      activeMesh = mesh; activeMeshIndex = meshes.indexOf(mesh);
      activeMesh.renderOrder = 500;
      
      const data = activeMesh.userData;

      if (data.media_url) {
        textureLoader.load(data.media_url, (highResTex) => {
          if (activeMesh === mesh) {
            activeMesh.material.uniforms.uTexture.value = highResTex;
            if (highResTex.image) activeMesh.material.uniforms.uTexAspect.value = highResTex.image.width / highResTex.image.height;
          }
        });
      }

      const focusTargetZ = 4.5;
      let currentZWrap = (data.zBase + scrollZ) % TOTAL_DEPTH;
      if (currentZWrap > 10) currentZWrap -= TOTAL_DEPTH;
      if (currentZWrap < -TOTAL_DEPTH + 10) currentZWrap += TOTAL_DEPTH;

      targetScrollZ += (focusTargetZ - currentZWrap);

      const workCounter = document.getElementById('work-counter');
      if (workCounter) workCounter.innerText = `${String(activeMeshIndex + 1).padStart(3, '0')} / ${String(meshes.length).padStart(3, '0')}`;

      const mDate = document.getElementById('modal-date'); if (mDate) mDate.innerText = `DATE // ${data.timestamp}`;
      const mType = document.getElementById('modal-type'); if (mType) mType.innerText = data.media_type || 'IMAGE';
      const mTitle = document.getElementById('modal-title'); if (mTitle) mTitle.innerText = data.title;
      const mCap = document.getElementById('modal-caption'); if (mCap) mCap.innerText = data.caption || "";
      const mLink = document.getElementById('modal-link') as HTMLAnchorElement; if (mLink) mLink.href = data.permalink;

      if (videoStage) {
        videoStage.innerHTML = '';
        if (data.media_type === 'VIDEO') {
          const video = document.createElement('video'); video.src = data.media_url; video.autoplay = true; video.loop = true; video.controls = true; video.playsInline = true;
          video.style.cssText = 'width:90%; max-width:800px; max-height:55vh; object-fit:contain; border-radius:4px; box-shadow:0 30px 60px rgba(0,0,0,0.12); pointer-events:auto;';
          videoStage.appendChild(video);
        } else if (data.media_type === 'CAROUSEL_ALBUM') {
          const children = data.children || []; let slideIndex = 0;
          const slides = children.length > 0 ? children.map((c: any) => c.media_url || c.thumbnail_url) : [data.media_url];
          const slideTextures = slides.map(url => textureLoader.load(url, (tex) => {
            if (tex.image && activeMesh) activeMesh.material.uniforms.uTexAspect.value = tex.image.width / tex.image.height;
          }));

          const controlsBox = document.createElement('div'); controlsBox.style.cssText = 'position:absolute; bottom:100px; left:50%; transform:translateX(-50%); pointer-events:auto; z-index:120;';
          const controls = document.createElement('div'); controls.style.cssText = 'display:flex; align-items:center; gap:16px; background:rgba(13,13,13,0.92); backdrop-filter:blur(16px); border:1px solid #C09E5A; padding:8px 22px; border-radius:20px; color:#ffffff; font-family:"Space Mono", monospace; font-size:11px; box-shadow:0 12px 32px rgba(0,0,0,0.25);';
          const btnPrev = document.createElement('button'); btnPrev.innerText = '[ PREV SLIDE ]'; btnPrev.style.cssText = 'background:none; border:none; color:#C09E5A; cursor:pointer; font-family:inherit; font-size:10px; font-weight:bold;';
          const counter = document.createElement('span'); counter.innerText = `01 / ${String(slides.length).padStart(2, '0')}`;
          const btnNext = document.createElement('button'); btnNext.innerText = '[ NEXT SLIDE ]'; btnNext.style.cssText = 'background:none; border:none; color:#C09E5A; cursor:pointer; font-family:inherit; font-size:10px; font-weight:bold;';

          function updateSlide(newIdx: number) {
            slideIndex = (newIdx + slides.length) % slides.length;
            if (activeMesh) {
              const currentTex = slideTextures[slideIndex]; activeMesh.material.uniforms.uTexture.value = currentTex;
              if (currentTex.image) activeMesh.material.uniforms.uTexAspect.value = currentTex.image.width / currentTex.image.height;
            }
            counter.innerText = `${String(slideIndex + 1).padStart(2, '0')} / ${String(slides.length).padStart(2, '0')}`;
          }

          btnPrev.addEventListener('click', (e) => { e.stopPropagation(); updateSlide(slideIndex - 1); });
          btnNext.addEventListener('click', (e) => { e.stopPropagation(); updateSlide(slideIndex + 1); });
          controls.appendChild(btnPrev); controls.appendChild(counter); controls.appendChild(btnNext); controlsBox.appendChild(controls);
          if (slides.length > 1) videoStage.appendChild(controlsBox);
        }
      }

      editorialStage?.classList.add('is-active'); brandLogo?.classList.add('is-focused'); 
      if (fixedHoverHud) fixedHoverHud.classList.remove('is-active');
    }

    function navigateWork(direction: number) {
      if (meshes.length === 0 || activeMeshIndex === -1) return;
      const nextIdx = (activeMeshIndex + direction + meshes.length) % meshes.length;
      openModalForMesh(meshes[nextIdx]);
    }

    document.getElementById('btn-prev-work')?.addEventListener('click', (e) => { e.stopPropagation(); navigateWork(-1); });
    document.getElementById('btn-next-work')?.addEventListener('click', (e) => { e.stopPropagation(); navigateWork(1); });
    document.getElementById('btn-close')?.addEventListener('click', (e) => { e.stopPropagation(); closeModal(); });
    
    // 🎹 TASTIERA DUAL-CONTEXT
    window.addEventListener('keydown', (e) => { 
      if (e.key === 'Escape') {
        closeModal();
        closeAllDrawers();
      }
      
      if (activeMesh) { 
        if (e.key === 'ArrowRight') navigateWork(1); 
        if (e.key === 'ArrowLeft') navigateWork(-1); 
      } else {
        if (e.key === 'ArrowUp') snowScaleFactor = Math.min(snowScaleFactor + 0.15, 3.5);
        if (e.key === 'ArrowDown') snowScaleFactor = Math.max(snowScaleFactor - 0.10, 0.2);
        
        if (e.key === 'ArrowLeft') snowSpeedFactor = Math.max(snowSpeedFactor - 0.10, 0.05);
        if (e.key === 'ArrowRight') snowSpeedFactor = Math.min(snowSpeedFactor + 0.15, 3.5);
      }
    });

    window.addEventListener('wheel', (e) => { 
      if(!activeMesh && !activeDrawer) {
        targetScrollZ += e.deltaY * 0.035;
      }
    }, { passive: true });

    window.addEventListener('pointerdown', (e) => { isDragging = true; dragStartY = e.clientY; });
    
    window.addEventListener('pointermove', (e) => {
      mouse.targetX = (e.clientX / window.innerWidth - 0.5) * 2;
      mouse.targetY = -(e.clientY / window.innerHeight - 0.5) * 2;

      if (!activeMesh && !activeDrawer && !isDragging) {
        const rectDom = renderer.domElement.getBoundingClientRect();
        clickMouse.x = ((e.clientX - rectDom.left) / rectDom.width) * 2 - 1; 
        clickMouse.y = -((e.clientY - rectDom.top) / rectDom.height) * 2 + 1;

        camera.updateMatrixWorld(true);
        raycaster.setFromCamera(clickMouse, camera);
        const intersects = raycaster.intersectObjects(meshes, false);

        if (intersects.length > 0 && fixedHoverHud && fixedHoverTitle) {
          const hoveredMesh = intersects[0].object as THREE.Mesh;
          fixedHoverTitle.innerText = hoveredMesh.userData.title || "OPERA D'ARCHIVIO";
          fixedHoverHud.classList.add('is-active');
        } else if (fixedHoverHud) {
          fixedHoverHud.classList.remove('is-active');
        }
      } else if (fixedHoverHud) {
        fixedHoverHud.classList.remove('is-active');
      }

      if (isDragging && !activeMesh && !activeDrawer) {
        const deltaY = e.clientY - dragStartY;
        targetScrollZ += deltaY * DRAG_MULTIPLIER;
        dragStartY = e.clientY;
      }
    });

    window.addEventListener('pointerup', (e) => {
      isDragging = false;
      if (activeDrawer) return;

      if (activeMesh) {
        const card = document.getElementById('editorial-card'); const stageControls = document.getElementById('video-stage');
        if (card && !card.contains(e.target as Node) && stageControls && !stageControls.contains(e.target as Node)) closeModal();
        return;
      }

      const rectDom = renderer.domElement.getBoundingClientRect();
      clickMouse.x = ((e.clientX - rectDom.left) / rectDom.width) * 2 - 1; 
      clickMouse.y = -((e.clientY - rectDom.top) / rectDom.height) * 2 + 1;
      
      camera.updateMatrixWorld(true);
      const intersects = raycaster.intersectObjects(meshes, false);
      if (intersects.length > 0) {
        openModalForMesh(intersects[0].object as THREE.Mesh);
      }
    });

    const clock = new THREE.Clock();

    function animate() {
      requestAnimationFrame(animate);
      const elapsedTime = clock.getElapsedTime();

      prevScrollZ = scrollZ;
      scrollZ += (targetScrollZ - scrollZ) * 0.08;
      scrollVelocity = scrollZ - prevScrollZ;

      mouse.x += (mouse.targetX - mouse.x) * 0.05;
      mouse.y += (mouse.targetY - mouse.y) * 0.05;

      let bassIntensity = 0.0;
      if (analyser && audioDataArray && isAudioPlaying) {
        analyser.getByteFrequencyData(audioDataArray);
        let bassSum = audioDataArray[0] + audioDataArray[1] + audioDataArray[2] + audioDataArray[3];
        let rawBass = (bassSum / 4) / 255.0;
        bassIntensity = Math.pow(rawBass, 2.5);
      }

      const targetFOV = 60 + Math.min(Math.abs(scrollVelocity) * 3.5, 20);
      camera.fov += (targetFOV - camera.fov) * 0.1;
      camera.updateProjectionMatrix();

      if (!activeMesh && !activeDrawer) {
        worldGroup.position.x += (-mouse.x * 6.5 - worldGroup.position.x) * 0.06;
        worldGroup.position.y += (mouse.y * 5.5 - worldGroup.position.y) * 0.06;

        worldGroup.rotation.y += (mouse.x * 0.40 - worldGroup.rotation.y) * 0.06;
        worldGroup.rotation.x += (-mouse.y * 0.40 - worldGroup.rotation.x) * 0.06;

        camera.position.x += (mouse.x * 1.5 - camera.position.x) * 0.06;
        camera.position.y += (-mouse.y * 1.5 - camera.position.y) * 0.06;
        camera.lookAt(-mouse.x * 4.5, mouse.y * 3.5, -20);
      } else {
        worldGroup.position.x += (0 - worldGroup.position.x) * 0.08;
        worldGroup.position.y += (0 - worldGroup.position.y) * 0.08;
        worldGroup.rotation.y += (0 - worldGroup.rotation.y) * 0.08;
        worldGroup.rotation.x += (0 - worldGroup.rotation.x) * 0.08;

        camera.position.x += (0 - camera.position.x) * 0.08;
        camera.position.y += (0 - camera.position.y) * 0.08;
        camera.lookAt(0, 0, -10);
      }

      const pulseOpacity = 0.70 + Math.sin(elapsedTime * 2.8) * 0.28;

      // ❄️ DISSOLVENZA OPACITÀ NEVE DINAMICA IN BASE ALLA MODALITÀ!
      // In Ispezione Opera o Drawer aperto -> Opacità sottile (0.12) per non disturbare la visione!
      const targetSnowOpacity = (activeMesh || activeDrawer) ? 0.12 : 0.42;
      particleMaterial.opacity += (targetSnowOpacity - particleMaterial.opacity) * 0.08;

      // 💫 FISICA NEVE TRICROMA WIDESCREEN
      for (let p = 0; p < particleCount; p++) {
        const pData = particleData[p];
        
        const audioSpeedBoost = 1.0 + bassIntensity * 3.8;
        pData.y -= pData.vy * snowSpeedFactor * audioSpeedBoost;
        pData.x += Math.sin(elapsedTime * 1.2 + p * 0.1) * 0.01;
        pData.rx += pData.vrx * snowSpeedFactor * audioSpeedBoost; 
        pData.ry += pData.vry * snowSpeedFactor * audioSpeedBoost; 
        pData.rz += pData.vrz * snowSpeedFactor * audioSpeedBoost;
        
        pData.z += scrollVelocity * 2.2;

        if (activeMesh && pData.z > -4.8) {
          pData.z = -5.2 - Math.random() * 8.0;
        }

        // Rigenerazione su ampiezza Widescreen X: [-24, +24]
        if (pData.y < -16) { pData.y = 16; pData.x = (Math.random() - 0.5) * 48; }
        if (pData.z > 5) pData.z -= 40;
        if (pData.z < -35) pData.z += 40;
        
        const audioScalePulse = snowScaleFactor * (1.0 + bassIntensity * 1.2);
        const zStretch = 1.0 + Math.abs(scrollVelocity) * 2.8 + bassIntensity * 1.5;

        dummyMatrix.position.set(pData.x, pData.y, pData.z);
        dummyMatrix.rotation.set(pData.rx, pData.ry, pData.rz);
        dummyMatrix.scale.set(audioScalePulse, audioScalePulse, audioScalePulse * zStretch);
        dummyMatrix.updateMatrix();
        pixelSnowSystem.setMatrixAt(p, dummyMatrix.matrix);
      }
      pixelSnowSystem.instanceMatrix.needsUpdate = true;

      // 🌌 MATEMATICA VORTICE & DISSOLVENZA PULITA DALLA NEBBIA
      meshes.forEach((mesh, idx) => {
        const mat = materials[idx]; const data = mesh.userData;
        const badgeMat = data.badgeMat as THREE.MeshBasicMaterial | null;

        let currentZ = (data.zBase + scrollZ) % TOTAL_DEPTH;
        if (currentZ > 10) currentZ -= TOTAL_DEPTH;
        if (currentZ < -TOTAL_DEPTH + 10) currentZ += TOTAL_DEPTH;

        mat.uniforms.uTime.value = elapsedTime;
        mat.uniforms.uVelocity.value = scrollVelocity;

        const loadedOpacity = data.isLoaded ? 1.0 : 0.0;
        const targetOpacity = activeDrawer ? 0.15 * loadedOpacity : (mesh === activeMesh ? 1.0 * loadedOpacity : 1.0 * loadedOpacity);

        if (activeDrawer) {
          mesh.position.x += (data.baseX - mesh.position.x) * 0.1;
          mesh.position.y += (data.baseY - mesh.position.y) * 0.1;
          mesh.position.z = currentZ;

          mat.uniforms.uFocus.value += (0.0 - mat.uniforms.uFocus.value) * 0.1;
          mat.uniforms.uOpacity.value += (targetOpacity - mat.uniforms.uOpacity.value) * 0.08;
          if (badgeMat) badgeMat.opacity = 0.0;
        } else if (activeMesh) {
           if (mesh === activeMesh) {
             const isMobile = window.innerWidth < 640;
             const isolationX = 0;
             const isolationY = isMobile ? -0.45 : 0.0;
             const isolationZ = -4.5;

             mesh.position.x += (isolationX - mesh.position.x) * 0.1;
             mesh.position.y += (isolationY - mesh.position.y) * 0.1;
             mesh.position.z += (isolationZ - mesh.position.z) * 0.1;

             mesh.rotation.y += (mouse.x * 0.04 - mesh.rotation.y) * 0.1;
             mesh.rotation.x += (-mouse.y * 0.04 - mesh.rotation.x) * 0.1;
             mesh.rotation.z += (0 - mesh.rotation.z) * 0.1;

             mat.uniforms.uMouse.value.set((mouse.x + 1) * 0.5, (mouse.y + 1) * 0.5);
             mat.uniforms.uFocus.value += (1.0 - mat.uniforms.uFocus.value) * 0.1;
             mat.uniforms.uOpacity.value += (targetOpacity - mat.uniforms.uOpacity.value) * 0.1;
             if (badgeMat) badgeMat.opacity = pulseOpacity;

             laserMaterial.opacity += (0.95 - laserMaterial.opacity) * 0.1;
             const posAttr = laserGeometry.attributes.position as THREE.BufferAttribute;
             const arr = posAttr.array as Float32Array;
             const twX = mesh.position.x; const twY = mesh.position.y; const twZ = mesh.position.z + 0.08;
             const w = 1.1 + 0.25; const h = 1.4 + 0.25; const len = 0.25;

             let i = 0;
             arr[i++] = twX - w;       arr[i++] = twY + h;       arr[i++] = twZ;
             arr[i++] = twX - w + len; arr[i++] = twY + h;       arr[i++] = twZ;
             arr[i++] = twX - w;       arr[i++] = twY + h;       arr[i++] = twZ;
             arr[i++] = twX - w;       arr[i++] = twY + h - len; arr[i++] = twZ;

             arr[i++] = twX + w;       arr[i++] = twY + h;       arr[i++] = twZ;
             arr[i++] = twX + w - len; arr[i++] = twY + h;       arr[i++] = twZ;
             arr[i++] = twX + w;       arr[i++] = twY + h;       arr[i++] = twZ;
             arr[i++] = twX + w;       arr[i++] = twY + h - len; arr[i++] = twZ;

             arr[i++] = twX + w;       arr[i++] = twY - h;       arr[i++] = twZ;
             arr[i++] = twX + w - len; arr[i++] = twY - h;       arr[i++] = twZ;
             arr[i++] = twX + w;       arr[i++] = twY - h;       arr[i++] = twZ;
             arr[i++] = twX + w;       arr[i++] = twY - h + len; arr[i++] = twZ;

             arr[i++] = twX - w;       arr[i++] = twY - h;       arr[i++] = twZ;
             arr[i++] = twX - w + len; arr[i++] = twY - h;       arr[i++] = twZ;
             arr[i++] = twX - w;       arr[i++] = twY - h;       arr[i++] = twZ;
             arr[i++] = twX - w;       arr[i++] = twY - h + len; arr[i++] = twZ;
             posAttr.needsUpdate = true;

           } else {
             mesh.position.x += (data.baseX - mesh.position.x) * 0.1;
             mesh.position.y += (data.baseY - mesh.position.y) * 0.1;
             mesh.position.z = currentZ;

             mesh.rotation.x += (data.rotX - mesh.rotation.x) * 0.1;
             mesh.rotation.y += (data.rotY - mesh.rotation.y) * 0.1;

             mat.uniforms.uFocus.value += (0.0 - mat.uniforms.uFocus.value) * 0.1;
             mat.uniforms.uOpacity.value += (0.00 - mat.uniforms.uOpacity.value) * 0.1;
             if (badgeMat) badgeMat.opacity = 0.0;
           }
        } else {
           mesh.position.x += (data.baseX - mesh.position.x) * 0.1;
           mesh.position.y += (data.baseY - mesh.position.y) * 0.1;
           mesh.position.z = currentZ;

           mesh.rotation.x += (data.rotX - mesh.rotation.x) * 0.1;
           mesh.rotation.y += (data.rotY - mesh.rotation.y) * 0.1;

           mat.uniforms.uFocus.value += (0.0 - mat.uniforms.uFocus.value) * 0.1;
           mat.uniforms.uOpacity.value += (targetOpacity - mat.uniforms.uOpacity.value) * 0.08;
           if (badgeMat) badgeMat.opacity = data.isLoaded ? pulseOpacity : 0.0;

           laserMaterial.opacity += (0.0 - laserMaterial.opacity) * 0.15;
        }
      });

      renderer.render(scene, camera);
    }
    animate();

    window.addEventListener('resize', () => {
      camera.aspect = window.innerWidth / window.innerHeight;
      camera.updateProjectionMatrix();
      renderer.setSize(window.innerWidth, window.innerHeight);
    });
  }
</script>
