</style>
<script id="imland-v43-controller" is:inline>
(function(){
  if (window.__V43) return; window.__V43 = 1;

  // 1. Scudo anti-flicker + promozione stacking context (z-index: 300) su tutti i genitori del menu
  const clean = (el) => {
    if (!el || !el.style) return;
    ['left','right','top','bottom','transform','writing-mode','position','width'].forEach((p) => el.style.removeProperty(p));
    el.style.setProperty('z-index', '300', 'important');
    el.style.setProperty('opacity', '1', 'important');
    el.style.setProperty('visibility', 'visible', 'important');
  };
  const arm = () => {
    const n = document.querySelector('[data-imland-nav="1"]');
    if (!n) return;
    const run = () => {
      let c = n;
      while (c && c !== document.body) {
        clean(c);
        c = c.parentElement;
      }
    };
    run();
    let c = n;
    while (c && c !== document.body) {
      new MutationObserver(run).observe(c, { attributes: true, attributeFilter: ['style'] });
      c = c.parentElement;
    }
  };
  document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', arm) : arm();
  window.addEventListener('resize', () => {
    let c = document.querySelector('[data-imland-nav="1"]');
    while (c && c !== document.body) { clean(c); c = c.parentElement; }
  });

  // 2. Pulizia garantita dell'HUD carosello ogni volta che #editorial-stage si chiude o si preme ESC
  function cleanupCarouselHudIfClosed() {
    const st = document.getElementById('editorial-stage');
    const isOpen = Boolean(st && st.classList.contains('is-active'));
    document.body.classList.toggle('imland-focus-open', isOpen);
    if (!isOpen) {
      if (window.__V43_FOCUS) window.__V43_FOCUS.active = false;
      document.getElementById('imland-v43-hud')?.remove();
      document.getElementById('imland-carousel-controls')?.remove();
      document.getElementById('imland-video-pill')?.remove();
      Array.from(document.body.children).forEach((el) => {
        const tx = (el.textContent || '').trim();
        if (tx.length > 0 && tx.length < 130 && (tx.includes('PREV SLIDE') || tx.includes('NEXT SLIDE') || tx.includes('GUARDA VIDEO'))) {
          el.remove();
        }
      });
    }
  }

  // 3. Intercetta la barra hover in alto a destra e la sposta in basso a destra in bianco satinato
  function bindWhiteHoverPreview() {
    cleanupCarouselHudIfClosed();
    if (document.querySelector('[data-imland-hover-preview="1"]')) return;
    document.querySelectorAll('div, span, p, aside').forEach((el) => {
      if (el.closest('[data-imland-nav="1"]') || el.closest('[data-imland-logo="1"]') || el.closest('#editorial-stage') || el.closest('#imland-v43-hud')) return;
      const r = el.getBoundingClientRect();
      const cs = getComputedStyle(el);
      const tx = (el.textContent || '').trim();
      const isTopRightHud =
        cs.position === 'fixed' &&
        r.top >= 0 && r.top < 110 &&
        r.right > window.innerWidth - 260 &&
        r.width > 90 && r.height > 14 && r.height < 72 &&
        (tx.includes('TARGET //') || cs.backgroundColor.includes('0, 0, 0') || cs.backgroundColor.includes('17, 17, 17') || cs.backgroundColor.includes('18, 18, 18') || cs.backgroundColor.includes('24, 24, 24'));
      if (isTopRightHud) {
        el.setAttribute('data-imland-hover-preview', '1');
      }
    });
  }

  // 4. IMWEAR 8-3-5 poliritmico + Dissolvenza poetica GPU
  const CAT = {
    c1: ['/brand/hoodie-2.jpg','/brand/hoodie-3.jpg','/brand/hoodie-4.jpg','/brand/hoodie-5.jpg','/brand/hoodie-6.jpg','/brand/hoodie-7.jpg','/brand/hoodie-8.jpg','/brand/hoodie-9.jpg'],
    c2: ['/brand/hoodie_zip-1.jpg','/brand/hoodie_zip-2.jpg','/brand/hoodie_zip-3.jpg'],
    c3: ['/brand/tee-1.jpg','/brand/tee-2.jpg','/brand/tee-3.jpg','/brand/tee-4.jpg','/brand/tee-5.jpg']
  };
  const idx = { c1: 0, c2: 0, c3: 0 }, busy = { c1: false, c2: false, c3: false };
  let tick = 0;

  function poeticSwap(k, st, base, nextSrc) {
    if (busy[k] || base.getAttribute('src') === nextSrc) return;
    busy[k] = true;
    const pre = new Image();
    pre.onload = () => {
      st.querySelectorAll('img.imwear-dissolve').forEach((o) => o.remove());
      const g = document.createElement('img'); g.src = nextSrc; g.alt = base.alt || 'IMLAND'; g.className = 'imwear-dissolve'; st.appendChild(g);
      requestAnimationFrame(() => requestAnimationFrame(() => g.classList.add('is-visible')));
      setTimeout(() => { base.setAttribute('src', nextSrc); g.remove(); busy[k] = false; }, 1220);
    };
    pre.onerror = () => { busy[k] = false; };
    pre.src = nextSrc;
  }

  function syncAll(adv) {
    bindWhiteHoverPreview();
    document.querySelectorAll('div, aside, span').forEach((el) => {
      const tx = (el.textContent || '').trim();
      if (tx.includes('ARCHIVE 2026') && tx.length < 80) {
        let b = el; while (b.parentElement && b.parentElement !== document.body && ['fixed','absolute'].includes(getComputedStyle(b.parentElement).position)) b = b.parentElement;
        b.style.zIndex = '20';
      }
    });
    const bm = document.getElementById('brand-modal');
    const vis = bm && getComputedStyle(bm).display !== 'none';
    if (bm) {
      if (adv) tick += 1;
      const t = { c1: null, c2: null, c3: null };
      bm.querySelectorAll('article, div, section').forEach((el) => {
        if (!el.querySelector('img')) return;
        const u = (el.textContent || '').toUpperCase();
        const a = u.includes('CLASSIC HOODIE'), b = u.includes('FULL-ZIP'), c = u.includes('ESSENTIALS');
        if (a && !b && !c) t.c1 = el; if (b && !a && !c) t.c2 = el; if (c && !a && !b) t.c3 = el;
      });
      ['c1','c2','c3'].forEach((k) => {
        if (!t[k]) return;
        const imgs = Array.from(t[k].querySelectorAll('img:not(.imwear-dissolve)'));
        if (!imgs.length) return;
        for (let i = 1; i < imgs.length; i++) imgs[i].remove();
        const base = imgs[0]; base.classList.add('imwear-base');
        const st = base.parentElement; if (st) st.classList.add('imwear-poetic-stage');
        if (!adv) { if (base.getAttribute('src') !== CAT[k][idx[k]]) base.setAttribute('src', CAT[k][idx[k]]); return; }
        if (!vis || !st || (k === 'c2' && tick % 2 !== 0)) return;
        idx[k] = (idx[k] + 1) % CAT[k].length;
        poeticSwap(k, st, base, CAT[k][idx[k]]);
      });
    }
    ['#brand-modal','#contacts-modal','#manifesto-modal'].forEach((q) => {
      const o = document.querySelector(q); if (!o) return;
      if (o.parentElement !== document.body) document.body.appendChild(o);
      if (getComputedStyle(o).display !== 'none') {
        o.style.cssText += ';position:fixed!important;inset:0!important;width:100vw!important;height:100dvh!important;padding:0!important;margin:0!important;transform:none!important;display:flex!important;align-items:center!important;justify-content:center!important;';
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    syncAll(false);
    const st = document.getElementById('editorial-stage');
    if (st) {
      new MutationObserver(cleanupCarouselHudIfClosed).observe(st, { attributes: true, attributeFilter: ['class'] });
    }
  });
  document.addEventListener('mousemove', bindWhiteHoverPreview, { passive: true });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setTimeout(cleanupCarouselHudIfClosed, 10); });
  document.addEventListener('click', () => setTimeout(() => syncAll(false), 15));
  setInterval(() => syncAll(true), 2800);
})();
</script>
