<script>
  import * as THREE from 'three';
  import rawData from '../portfolio_cache.json';

  let audioCtx: AudioContext | null = null;
  let analyser: AnalyserNode | null = null;
  let audioDataArray: Uint8Array | null = null;
  let isAudioPlaying = false;

  const bgAudio = document.getElementById('bg-soundtrack') as HTMLAudioElement;
  const btnAudioToggle = document.getElementById('btn-audio-toggle');

  function initAudioContext() {
    if (audioCtx) return;
    try {
      audioCtx = new (window.AudioContext || (window as any).webkitAudioContext)();
      if (bgAudio) {
        const source = audioCtx.createMediaElementSource(bgAudio);
        analyser = audioCtx.createAnalyser();
        analyser.fftSize = 64;
        source.connect(analyser);
        analyser.connect(audioCtx.destination);
        audioDataArray = new Uint8Array(analyser.frequencyBinCount);
      }
    } catch (e) {
      console.warn("Audio Context init fallback:", e);
    }
  }

  function toggleAudio() {
    initAudioContext();
    if (audioCtx && audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    if (bgAudio) {
      if (isAudioPlaying) {
        bgAudio.pause();
        isAudioPlaying = false;
        if (btnAudioToggle) btnAudioToggle.innerText = '🔊 SOUND: OFF';
      } else {
        bgAudio.play().then(() => {
          isAudioPlaying = true;
          if (btnAudioToggle) btnAudioToggle.innerText = '🔊 SOUND: ON';
        }).catch(err => console.log("Audio gesture required:", err));
      }
    }
  }

  btnAudioToggle?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleAudio();
  });

  let isMixFiltered = false;
  const btnFilterMix = document.getElementById('btn-filter-mix');

  btnFilterMix?.addEventListener('click', (e) => {
    e.stopPropagation();
    isMixFiltered = !isMixFiltered;
    btnFilterMix.classList.toggle('is-active', isMixFiltered);
  });

  let activeDrawer: HTMLElement | null = null;

  function closeAllDrawers() {
    document.querySelectorAll('.editorial-drawer').forEach(el => el.classList.remove('is-active'));
    activeDrawer = null;
  }

  document.querySelectorAll('.hud-menu-btn').forEach(btn => {
    if (btn.id === 'btn-audio-toggle') return;
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      const targetId = (btn as HTMLElement).dataset.target;
      if (!targetId) return;
      const targetDrawer = document.getElementById(targetId);
      
      if (targetDrawer === activeDrawer) {
        closeAllDrawers();
      } else {
        closeAllDrawers();
        if (targetDrawer) {
          targetDrawer.classList.add('is-active');
          activeDrawer = targetDrawer;
        }
      }
    });
  });

  document.querySelectorAll('.btn-close-drawer').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      closeAllDrawers();
    });
  });

  document.querySelectorAll('.editorial-drawer').forEach(drawer => {
    drawer.addEventListener('click', (e) => {
      const contentBox = drawer.querySelector('.drawer-content-box');
      if (contentBox && !contentBox.contains(e.target as Node)) {
        closeAllDrawers();
      }
    });
  });

  // 🎨 GENERATORE SCHEDA MINERALE D'ARCHIVIO (IMPAGINAZIONE CENTRATA)
  function createFallbackTexture(item: any, index: number) {
    const canvas = document.createElement('canvas');
    canvas.width = 512; canvas.height = 640;
    const ctx = canvas.getContext('2d');
    if (!ctx) return new THREE.CanvasTexture(canvas);

    // Sfondo carta minerale
    ctx.fillStyle = '#f0f0ec'; 
    ctx.fillRect(0, 0, 512, 640);
    
    // Filigrana topografica procedurale in sottofondo
    ctx.strokeStyle = 'rgba(192, 158, 90, 0.18)';
    ctx.lineWidth = 1;
    for (let r = 1; r <= 6; r++) {
      ctx.beginPath();
      ctx.arc(256, 320, r * 42 + (index % 7) * 4, 0, Math.PI * 2);
      ctx.stroke();
    }

    // 🎯 INTESTAZIONE SUPERIORE (Centrata e proporzionata)
    const nodeNum = String(index + 1).padStart(3, '0');
    const altM = 1200 + (index * 43) % 2850;
    
    ctx.fillStyle = '#C09E5A';
    ctx.font = '700 13px "Space Mono", monospace';
    ctx.textAlign = 'center';
    ctx.fillText(`NODE // ${nodeNum}  •  ${altM}m ALT`, 256, 80);

    // 🎯 TITOLO CENTRALE BILINGUE (Aumentato impatto visivo)
    const rawTitle = parseBilingualTitle(item?.caption || "MATERIA ISOLATA");
    ctx.fillStyle = '#0d0d0d';
    ctx.font = '800 24px "Syne", sans-serif';
    ctx.textAlign = 'center';
    
    const words = rawTitle.split(' ');
    let line = '';
    let y = 300;
    for(let n = 0; n < words.length; n++) {
      let testLine = line + words[n] + ' ';
      let metrics = ctx.measureText(testLine);
      if (metrics.width > 420 && n > 0) {
        ctx.fillText(line, 256, y);
        line = words[n] + ' ';
        y += 32;
      } else {
        line = testLine;
      }
    }
    ctx.fillText(line, 256, y);

    // 🎯 COORDINATE INFERIORI (Centrate, eleganti e staccate dai bordi)
    const latSec = String((12 + index * 7) % 60).padStart(2, '0');
    const lonSec = String((05 + index * 13) % 60).padStart(2, '0');
    
    ctx.fillStyle = '#C09E5A';
    ctx.font = '700 12px "Space Mono", monospace';
    ctx.fillText(`45° 51' ${latSec}" N // 07° 56' ${lonSec}" E`, 256, 540);
    
    ctx.fillStyle = '#8c8c8c';
    ctx.font = '10px "Space Mono", monospace';
    ctx.fillText('IMLAND MONTEROSA // ALAGNA VALSESIA', 256, 565);

    const texture = new THREE.CanvasTexture(canvas);
    texture.needsUpdate = true;
    return texture;
  }

  function parseBilingualTitle(caption: string) {
    if (!caption) return "OPERA D'ARCHIVIO";
    let cleanText = caption.replace(/#\w+/g, '').replace(/@\w+/g, '').trim();
    let rawLines = cleanText.split(/[\r\n]+/).map(l => l.trim()).filter(l => l.length > 0);
    let contentLines = rawLines.filter(line => !/IMLAND/i.test(line));
    if (contentLines.length === 0) return "MATERIA ISOLATA";
    let targetLine = contentLines[0];

    if (targetLine.includes('/')) {
      let parts = targetLine.split('/').map(p => p.trim().replace(/^['"•\s]+|['"•\s]+$/g, '')).filter(p => p.length > 0);
      parts = parts.filter(p => !/IMLAND/i.test(p));
      if (parts.length >= 2) return `${parts[0].toUpperCase()} / ${parts[1].toUpperCase()}`;
      else if (parts.length === 1) return parts[0].toUpperCase();
    }
    if (contentLines.length >= 2) {
      let itTitle = targetLine.toUpperCase();
      let enTitle = contentLines[1].toUpperCase();
      if (enTitle.length > 2 && !enTitle.startsWith('HTTP') && !/IMLAND/i.test(enTitle)) {
        if ((itTitle.length + enTitle.length) < 60) return `${itTitle} / ${enTitle}`;
      }
    }
    return targetLine.substring(0, 48).toUpperCase();
  }

  function createBadgeTexture(type: string) {
    const canvas = document.createElement('canvas'); canvas.width = 128; canvas.height = 128; const ctx = canvas.getContext('2d');
    if (!ctx) return new THREE.CanvasTexture(canvas);
    ctx.clearRect(0, 0, 128, 128); ctx.fillStyle = '#C09E5A'; ctx.strokeStyle = '#C09E5A';
    if (type === 'VIDEO') { ctx.beginPath(); ctx.moveTo(42, 32); ctx.lineTo(92, 64); ctx.lineTo(42, 96); ctx.closePath(); ctx.fill(); } 
    else if (type === 'CAROUSEL_ALBUM') { ctx.lineWidth = 10; ctx.lineJoin = 'round'; ctx.strokeRect(28, 48, 48, 48); ctx.fillRect(48, 24, 48, 48); ctx.strokeStyle = '#0d0d0d'; ctx.lineWidth = 2; ctx.strokeRect(48, 24, 48, 48); }
    const texture = new THREE.CanvasTexture(canvas); texture.premultiplyAlpha = true; texture.needsUpdate = true; return texture;
  }

  const container = document.getElementById('canvas-container');
  if (container) {
    const scene = new THREE.Scene();
    scene.fog = new THREE.FogExp2(0xf2f2f0, 0.020);

    const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.set(0, 0, 0);

    const renderer = new THREE.WebGLRenderer({ antialias: window.innerWidth > 768, alpha: true });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(window.innerWidth <= 768 ? 1 : Math.min(window.devicePixelRatio, 1.5));
    renderer.setClearColor(0xf2f2f0, 1); 
    container.appendChild(renderer.domElement);

    const topoGroup = new THREE.Group();
    scene.add(topoGroup);

    const ISO_COUNT = 16;
    const ISO_DEPTH_STEP = 5.0;
    const ISO_TOTAL_DEPTH = ISO_COUNT * ISO_DEPTH_STEP;
    const topoLoops: { line: THREE.LineLoop; zBase: number; isSepia: boolean }[] = [];

    for (let k = 0; k < ISO_COUNT; k++) {
      const zPos = -k * ISO_DEPTH_STEP;
      const pointsCount = 120;
      const positions = new Float32Array((pointsCount + 1) * 3);

      const baseR = 7.0 + (k % 4) * 2.8 + k * 0.45;
      const seed1 = k * 1.7;
      const seed2 = k * 2.3;

      for (let i = 0; i <= pointsCount; i++) {
        const theta = (i / pointsCount) * Math.PI * 2;
        const wave1 = Math.sin(theta * 2.0 + seed1) * 2.2;
        const wave2 = Math.cos(theta * 3.0 - seed2) * 1.5;
        const wave3 = Math.sin(theta * 5.0 + seed1 * 0.5) * 0.8;
        const r = Math.max(2.0, baseR + wave1 + wave2 + wave3);

        positions[i * 3] = Math.cos(theta) * r;
        positions[i * 3 + 1] = Math.sin(theta) * r;
        positions[i * 3 + 2] = 0;
      }

      const geo = new THREE.BufferGeometry();
      geo.setAttribute('position', new THREE.BufferAttribute(positions, 3));

      const isSepia = k % 2 === 0;
      const lineMat = new THREE.LineBasicMaterial({
        color: isSepia ? 0xC09E5A : 0x282828,
        transparent: true,
        opacity: isSepia ? 0.75 : 0.42,
        linewidth: 1
      });

      const lineLoop = new THREE.LineLoop(geo, lineMat);
      lineLoop.position.set(0, 0, zPos);
      topoGroup.add(lineLoop);

      topoLoops.push({ line: lineLoop, zBase: zPos, isSepia });
    }

    const worldGroup = new THREE.Group();
    scene.add(worldGroup);

    const particleCount = 240;
    const particleTriangleGeo = new THREE.CircleGeometry(0.06, 3);
    const particleMaterial = new THREE.MeshBasicMaterial({ color: 0xffffff, transparent: true, opacity: 0.45, depthTest: true, depthWrite: false, side: THREE.DoubleSide });
    const pixelSnowSystem = new THREE.InstancedMesh(particleTriangleGeo, particleMaterial, particleCount);
    pixelSnowSystem.instanceMatrix.setUsage(THREE.DynamicDrawUsage);
    
    const snowPalette = [ new THREE.Color('#282828'), new THREE.Color('#C09E5A'), new THREE.Color('#2C5260') ];
    const dummyMatrix = new THREE.Object3D();
    
    let snowScaleFactor = window.innerWidth < 640 ? 0.7 : 1.0;
    let snowSpeedFactor = 0.55;

    const particleData: any[] = [];
    for (let p = 0; p < particleCount; p++) {
      pixelSnowSystem.setColorAt(p, snowPalette[Math.floor(Math.random() * snowPalette.length)]);
      particleData.push({
        x: (Math.random() - 0.5) * 48, y: (Math.random() - 0.5) * 32, z: (Math.random() - 0.5) * 35 - 10,
        vy: 0.003 + Math.random() * 0.006, rx: Math.random() * Math.PI * 2, ry: Math.random() * Math.PI * 2, rz: Math.random() * Math.PI * 2,
        vrx: (Math.random() - 0.5) * 0.035, vry: (Math.random() - 0.5) * 0.045, vrz: (Math.random() - 0.5) * 0.025
      });
    }
    if (pixelSnowSystem.instanceColor) pixelSnowSystem.instanceColor.needsUpdate = true;
    scene.add(pixelSnowSystem);

    const vertexShader = `
      varying vec2 vUv;
      uniform float uTime;
      uniform vec2 uMouse;
      uniform float uVelocity;
      uniform float uFocus;

      void main() {
        vUv = uv;
        vec3 pos = position;

        float dist = distance(uv, uMouse);
        float wave = sin(dist * 7.0 - uTime * 2.5) * (0.03 + abs(uVelocity) * 0.12);
        
        pos.z += wave;

        gl_Position = projectionMatrix * modelViewMatrix * vec4(pos, 1.0);
      }
    `;

    const fragmentShader = `
      varying vec2 vUv;
      uniform sampler2D uTexture;
      uniform float uTime;
      uniform float uVelocity;
      uniform float uFocus;
      uniform float uOpacity;
      uniform float uTexAspect;
      uniform vec2 uMouse;

      void main() {
        vec2 uv = vUv;
        float planeAspect = 2.2 / 2.8; 
        vec2 st = uv - 0.5;
        if (uTexAspect > 0.0) {
          if (uTexAspect > planeAspect) st.x *= planeAspect / uTexAspect;
          else st.y *= uTexAspect / planeAspect;
        }
        uv = st + 0.5;

        float distFromCenter = length(vUv - vec2(0.5));
        float distortion = sin(uv.y * 12.0 + uTime * 3.0) * (0.003 + abs(uVelocity) * 0.015) * (1.0 - uFocus);
        uv.x += distortion;

        float chromaMask = smoothstep(0.10, 0.75, distFromCenter);
        vec2 redOffset  = (vec2(0.0025, 0.001) * (1.0 + uFocus * 0.5) * chromaMask) + vec2(uVelocity * 0.01, 0.0);
        vec2 blueOffset = (vec2(-0.0025, -0.001) * (1.0 + uFocus * 0.5) * chromaMask) - vec2(uVelocity * 0.01, 0.0);

        float r = texture2D(uTexture, uv + redOffset).r;
        float g = texture2D(uTexture, uv).g;
        float b = texture2D(uTexture, uv + blueOffset).b;
        vec3 color = vec3(r, g, b);

        if (uFocus > 0.01) {
          float vignette = smoothstep(0.75, 0.20, distFromCenter);
          vec3 warmGalleryLight = vec3(1.02, 0.99, 0.95);
          color = mix(color, color * warmGalleryLight * (0.88 + 0.12 * vignette), uFocus);
        }
        gl_FragColor = vec4(color, uOpacity);
      }
    `;

    const textureLoader = new THREE.TextureLoader();

    // === V43 OBSIDIAN VIDEO PLATE, CAROUSEL HUD & MAGNETIC MOBILE TOUCH ENGINE ===
    const __v43CleanupHud = (keepActiveHud = false) => {
      if (!keepActiveHud) {
        document.getElementById('imland-v43-hud')?.remove();
      }
      document.getElementById('imland-v42-hud')?.remove();
      document.getElementById('imland-v41-hud')?.remove();
      document.getElementById('imland-v40-hud')?.remove();
      document.getElementById('imland-carousel-controls')?.remove();
      document.getElementById('imland-video-pill')?.remove();
      Array.from(document.body.children).forEach((el) => {
        const h = el as HTMLElement;
        if (!h || h.id === 'imland-v43-hud' || h.id === 'editorial-stage' || h.tagName === 'CANVAS') return;
        const tx = (h.textContent || '').trim();
        if (
          tx.length > 0 && tx.length < 130 &&
          (tx.includes('PREV SLIDE') || tx.includes('NEXT SLIDE') || tx.includes('GUARDA VIDEO') || tx.includes('GUARDA REEL'))
        ) {
          h.remove();
        }
      });
    };

    const __v43MakeObsidianPlate = (meta: any, ctaText: string) => {
      const c = document.createElement('canvas');
      c.width = 720;
      c.height = 900;
      const ctx = c.getContext('2d');
      if (!ctx) return null;
      const tex = new THREE.CanvasTexture(c);
      tex.minFilter = THREE.LinearFilter;
      tex.magFilter = THREE.LinearFilter;

      const draw = (wmImg?: HTMLImageElement | null) => {
        const g = ctx.createLinearGradient(0, 0, 720, 900);
        g.addColorStop(0, '#1a1917');
        g.addColorStop(1, '#0b0b0a');
        ctx.fillStyle = g;
        ctx.fillRect(0, 0, 720, 900);

        ctx.strokeStyle = 'rgba(200, 158, 90, 0.65)';
        ctx.lineWidth = 2;
        ctx.strokeRect(36, 36, 648, 828);

        ctx.fillStyle = '#C89E5A';
        ctx.font = '600 18px monospace';
        ctx.textAlign = 'left';
        ctx.textBaseline = 'alphabetic';
        ctx.fillText('IMLAND // MOTION ARCHIVE', 64, 88);

        ctx.fillStyle = 'rgba(255, 255, 255, 0.55)';
        ctx.font = '16px monospace';
        const dt = (meta && meta.timestamp) ? String(meta.timestamp).slice(0, 10) : 'ALAGNA VALSESIA';
        ctx.fillText(dt, 64, 118);

        if (wmImg && wmImg.complete && wmImg.naturalWidth > 0) {
          const w = 164;
          const h = Math.round((wmImg.naturalHeight / wmImg.naturalWidth) * w);
          const off = document.createElement('canvas');
          off.width = w; off.height = h;
          const ox = off.getContext('2d');
          if (ox) {
            ox.drawImage(wmImg, 0, 0, w, h);
            ox.globalCompositeOperation = 'source-in';
            ox.fillStyle = 'rgba(245, 240, 232, 0.92)';
            ox.fillRect(0, 0, w, h);
            ctx.save();
            ctx.globalAlpha = 0.9;
            ctx.drawImage(off, 656 - w, 58);
            ctx.restore();
          }
        }

        ctx.font = '600 16px monospace';
        const pw = Math.min(610, ctx.measureText(ctaText).width + 56);
        const ph = 56;
        const px = (720 - pw) / 2;
        const py = 440 - ph / 2;
        const r = ph / 2;

        ctx.save();
        ctx.shadowColor = 'rgba(0, 0, 0, 0.55)';
        ctx.shadowBlur = 24;
        ctx.shadowOffsetY = 8;
        ctx.beginPath();
        ctx.moveTo(px + r, py); ctx.lineTo(px + pw - r, py);
        ctx.quadraticCurveTo(px + pw, py, px + pw, py + r); ctx.lineTo(px + pw, py + ph - r);
        ctx.quadraticCurveTo(px + pw, py + ph, px + pw - r, py + ph); ctx.lineTo(px + r, py + ph);
        ctx.quadraticCurveTo(px, py + ph, px, py + ph - r); ctx.lineTo(px, py + r);
        ctx.quadraticCurveTo(px, py, px + r, py); ctx.closePath();
        ctx.fillStyle = 'rgba(26, 25, 23, 0.96)';
        ctx.fill();
        ctx.restore();

        ctx.beginPath();
        ctx.moveTo(px + r, py); ctx.lineTo(px + pw - r, py);
        ctx.quadraticCurveTo(px + pw, py, px + pw, py + r); ctx.lineTo(px + pw, py + ph - r);
        ctx.quadraticCurveTo(px + pw, py + ph, px + pw - r, py + ph); ctx.lineTo(px + r, py + ph);
        ctx.quadraticCurveTo(px, py + ph, px, py + ph - r); ctx.lineTo(px, py + r);
        ctx.quadraticCurveTo(px, py, px + r, py); ctx.closePath();
        ctx.strokeStyle = 'rgba(200, 158, 90, 0.95)';
        ctx.lineWidth = 2;
        ctx.stroke();

        ctx.fillStyle = '#C89E5A';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText(ctaText, 360, 441);

        const cap = String((meta && (meta.caption || meta.title)) || 'IMLAND MONTEROSA // REEL')
          .replace(/#\S+/g, '').replace(/\s+/g, ' ').trim().slice(0, 95);
        ctx.fillStyle = 'rgba(255, 255, 255, 0.88)';
        ctx.font = '500 21px sans-serif';
        ctx.textAlign = 'left';
        ctx.textBaseline = 'alphabetic';
        let ln = '', y = 716;
        for (const w of cap.split(' ')) {
          if (ctx.measureText(ln + w + ' ').width > 590 && ln) {
            ctx.fillText(ln.trim(), 64, y);
            ln = w + ' '; y += 32;
            if (y > 812) break;
          } else {
            ln += w + ' ';
          }
        }
        if (y <= 812 && ln.trim()) ctx.fillText(ln.trim(), 64, y);
        tex.needsUpdate = true;
      };

      draw(null);
      const wm = new Image();
      wm.crossOrigin = 'anonymous';
      wm.onload = () => draw(wm);
      wm.src = '/brand/logo-imland.png';
      return tex;
    };

    const __v43IsVideoItem = (entry: any) => {
      if (!entry) return false;
      if (typeof entry === 'string') return /\.mp4(\?|$)/i.test(entry);
      if (String(entry.media_type || '').toUpperCase() === 'VIDEO') return true;
      if (typeof entry.media_url === 'string' && /\.mp4(\?|$)/i.test(entry.media_url)) return true;
      return false;
    };

    const __v43SetupFocus = (meshObj: any, postObj: any) => {
      if (!meshObj || !postObj) return;
      __v43CleanupHud(false);

      const rawList = (postObj.children && Array.isArray(postObj.children.data))
        ? postObj.children.data
        : (Array.isArray(postObj.children) ? postObj.children : (Array.isArray(postObj.slides) ? postObj.slides : []));

      const fState = {
        active: true,
        mesh: meshObj,
        data: postObj,
        slideIdx: 0,
        items: rawList,
        textures: new Array(Math.max(1, rawList.length)).fill(null),
        applySlide(idx: number) {
          const list = this.items;
          if (!list || !list.length || !this.mesh) return;
          this.slideIdx = ((idx % list.length) + list.length) % list.length;
          const cur = list[this.slideIdx];
          const isVid = __v43IsVideoItem(cur);
          this.mesh.visible = true;
          this.mesh.userData.__isVideoPlateActive = isVid;
          this.mesh.userData.permalink = (cur && cur.permalink) || this.data.permalink || 'https://www.instagram.com/imlandmonterosa/';

          if (isVid) {
            let plate = this.textures[this.slideIdx];
            if (!plate || !plate.isCanvasTexture) {
              plate = __v43MakeObsidianPlate(
                {
                  timestamp: (cur && cur.timestamp) || this.data.timestamp,
                  caption: `${this.data.caption || this.data.title || 'IMLAND'} - SLIDE ${this.slideIdx + 1}/${list.length}`
                },
                '[ \u25b6 GUARDA VIDEO SLIDE SU INSTAGRAM \u2197 ]'
              );
              this.textures[this.slideIdx] = plate;
            }
            if (plate) {
              this.mesh.userData.coverTexture = plate;
              this.mesh.material.uniforms.uTexture.value = plate;
              this.mesh.material.uniforms.uTexAspect.value = 0.8;
            }
          } else {
            const cached = this.textures[this.slideIdx];
            if (cached && cached.image && cached.image.width > 0) {
              this.mesh.material.uniforms.uTexture.value = cached;
              this.mesh.material.uniforms.uTexAspect.value = cached.image.width / cached.image.height;
            } else {
              const url = typeof cur === 'string'
                ? cur
                : ((cur && cur.id ? `/archive_media/${cur.id}.jpg` : '') || (cur && (cur.media_url || cur.thumbnail_url)) || this.data.media_url);
              if (url) {
                textureLoader.load(url, (loadedTex) => {
                  if (loadedTex && loadedTex.image && loadedTex.image.width > 0) {
                    this.textures[this.slideIdx] = loadedTex;
                    if (this.mesh && this.active && this.items[this.slideIdx] === cur) {
                      this.mesh.visible = true;
                      this.mesh.material.uniforms.uTexture.value = loadedTex;
                      this.mesh.material.uniforms.uTexAspect.value = loadedTex.image.width / loadedTex.image.height;
                    }
                  }
                });
              }
            }
          }

          const cnt = document.getElementById('imland-v43-counter');
          if (cnt) {
            cnt.textContent = `${String(this.slideIdx + 1).padStart(2, '0')} / ${String(list.length).padStart(2, '0')}`;
          }
          __v43CleanupHud(true);
        }
      };

      (window as any).__V43_FOCUS = fState;

      // Post singolo VIDEO
      if (__v43IsVideoItem(postObj) && rawList.length <= 1) {
        meshObj.visible = true;
        meshObj.userData.__isVideoPlateActive = true;
        meshObj.userData.permalink = postObj.permalink || 'https://www.instagram.com/imlandmonterosa/';
        const singlePlate = __v43MakeObsidianPlate(postObj, '[ \u25b6 GUARDA VIDEO SU INSTAGRAM \u2197 ]');
        if (singlePlate) {
          meshObj.userData.coverTexture = singlePlate;
          meshObj.material.uniforms.uTexture.value = singlePlate;
          meshObj.material.uniforms.uTexAspect.value = 0.8;
        }
        return;
      }

      // Carosello multi-slide
      if (rawList.length > 1) {
        const hud = document.createElement('div');
        hud.id = 'imland-v43-hud';
        const isNarrow = window.innerWidth <= 1024;
        hud.style.cssText =
          `position:fixed;left:50%;bottom:${isNarrow ? '164px' : '36px'};transform:translateX(-50%);` +
          'display:flex;align-items:center;justify-content:center;gap:6px;' +
          'background:rgba(18,18,17,0.95);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);' +
          'border:1px solid rgba(200,158,90,0.68);border-radius:4px;padding:6px 14px;' +
          'box-shadow:0 14px 36px rgba(0,0,0,0.28);z-index:9999;pointer-events:auto;';

        const mkBtn = (label: string, step: number) => {
          const b = document.createElement('button');
          b.type = 'button';
          b.textContent = label;
          b.style.cssText =
            'background:none;border:none;color:#C89E5A;font-family:"Space Mono",monospace;' +
            'font-size:10px;font-weight:700;letter-spacing:0.1em;padding:6px 10px;' +
            'cursor:pointer;white-space:nowrap;pointer-events:auto;touch-action:manipulation;outline:none;';
          let lock = 0;
          const fire = (ev: Event) => {
            ev.preventDefault();
            ev.stopPropagation();
            ev.stopImmediatePropagation();
            const now = Date.now();
            if (now - lock < 150) return;
            lock = now;
            fState.applySlide(fState.slideIdx + step);
          };
          b.addEventListener('pointerdown', fire, { capture: true });
          b.addEventListener('click', fire, { capture: true });
          return b;
        };

        const cnt = document.createElement('span');
        cnt.id = 'imland-v43-counter';
        cnt.textContent = `01 / ${String(rawList.length).padStart(2, '0')}`;
        cnt.style.cssText =
          'color:#F5F0E8;font-family:"Space Mono",monospace;font-size:10px;font-weight:600;' +
          'letter-spacing:0.08em;padding:0 10px;white-space:nowrap;pointer-events:none;' +
          'border-left:1px solid rgba(200,158,90,0.3);border-right:1px solid rgba(200,158,90,0.3);';

        hud.appendChild(mkBtn('\u2039 PREV SLIDE', -1));
        hud.appendChild(cnt);
        hud.appendChild(mkBtn('NEXT SLIDE \u203a', 1));
        document.body.appendChild(hud);

        fState.applySlide(0);
        setTimeout(() => __v43CleanupHud(true), 0);
        setTimeout(() => __v43CleanupHud(true), 60);
      }
    };


function createArchivalPlateTexture(item: any) {
  const canvas = document.createElement('canvas');
  canvas.width = 720;
  canvas.height = 900;
  const ctx = canvas.getContext('2d');
  if (!ctx) return null;

  const grad = ctx.createLinearGradient(0, 0, 720, 900);
  grad.addColorStop(0, '#1a1917');
  grad.addColorStop(1, '#0c0c0b');
  ctx.fillStyle = grad;
  ctx.fillRect(0, 0, 720, 900);

  ctx.strokeStyle = 'rgba(200, 158, 90, 0.5)';
  ctx.lineWidth = 2;
  ctx.strokeRect(36, 36, 648, 828);

  ctx.fillStyle = '#C89E5A';
  ctx.font = '600 18px monospace';
  ctx.textAlign = 'left';
  ctx.fillText('IMLAND // MOTION ARCHIVE', 64, 88);

  const rawDate = (item && item.timestamp) ? String(item.timestamp).slice(0, 10) : 'ALAGNA VALSESIA';
  ctx.fillStyle = 'rgba(255, 255, 255, 0.55)';
  ctx.font = '16px monospace';
  ctx.fillText(rawDate, 64, 118);

  ctx.strokeStyle = 'rgba(255, 255, 255, 0.88)';
  ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.arc(360, 420, 46, 0, Math.PI * 2);
  ctx.stroke();

  ctx.fillStyle = '#ffffff';
  ctx.beginPath();
  ctx.moveTo(348, 400);
  ctx.lineTo(382, 420);
  ctx.lineTo(348, 440);
  ctx.closePath();
